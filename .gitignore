/vendor/rootfs/
/vendor/boot/
/vendor/stock/

# Buildroot's build output (the checkout itself is a submodule, tracked).
/buildroot/output/
/br-external/board/*/rootfs-overlay/**/output/

# Build artifacts
/sdcard.img
/sdcard.img.xz
*.o
*.so
build/
xbuild/
__pycache__/

# assembled SD images
/out/
