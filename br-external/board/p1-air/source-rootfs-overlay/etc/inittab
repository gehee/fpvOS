# Source kernel and independent recovery boot directly from NAND; root runs in RAM.
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/mkdir -p /dev/pts /run /tmp
::sysinit:/bin/mount -t devpts devpts /dev/pts
::sysinit:/bin/mount -t tmpfs tmpfs /run
::sysinit:/bin/mount -t tmpfs tmpfs /tmp
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/sbin/ip link set lo up
::sysinit:/etc/init.d/S40ar9311-usb start
::sysinit:/etc/init.d/S50dropbear start
# Factory access is read-only; USB/SSH remain available if it fails.
::sysinit:/etc/init.d/S43factory start
::sysinit:/etc/init.d/S44ar9311-radio start
::sysinit:/etc/init.d/S45settings start
::sysinit:/etc/init.d/S60kestrel-air start
::sysinit:/bin/cat /etc/issue

::respawn:/usr/sbin/fpvos-update-service
ttyS0::askfirst:-/bin/sh
::ctrlaltdel:/sbin/reboot
# First: the watchdog daemon goes without its magic close, so the watchdog
# stays armed (busybox's SIGTERM handler would disarm it, and the kernel then
# keeps the DW watchdog fed for good): a shutdown step that hangs resets the
# unit about 90 s later instead of never.
::shutdown:/usr/bin/killall -KILL watchdog
# Bridge mode (fpvOS_usb) undone before the USB gadget goes down: unbinding it
# under the bridge's FunctionFS endpoints hangs the reboot.
::shutdown:/usr/sbin/fpvos-usb shutdown
::shutdown:/etc/init.d/S60kestrel-air stop
::shutdown:/etc/init.d/S45settings stop
::shutdown:/etc/init.d/S43factory stop
::shutdown:/etc/init.d/S50dropbear stop
::shutdown:/etc/init.d/S40ar9311-usb stop
::shutdown:/bin/umount -a -r
