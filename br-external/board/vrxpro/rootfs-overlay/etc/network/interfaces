# Generated by buildroot, then edited: usb0 is STATIC, not DHCP.
#
# It used to be "iface usb0 inet dhcp". There is no DHCP server on the host end
# of the ECM gadget link, so udhcpc retried forever, and every attempt runs the
# deconfig action in /usr/share/udhcpc/default.script:
#     ifconfig usb0 0.0.0.0
# That wiped the 192.168.3.1 S30usbgadget had already assigned and left the
# board unreachable until something re-assigned it - the intermittent
# "No route to host" seen during development.
#
# vrxpro_defconfig leaves BR2_SYSTEM_DHCP unset. Keep it that way, or a rebuild
# regenerates the dhcp stanza and reintroduces this.

auto lo
iface lo inet loopback

auto usb0
iface usb0 inet static
  address 192.168.3.1
  netmask 255.255.255.0
