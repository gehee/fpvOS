// SPDX-License-Identifier: GPL-2.0-or-later
/* BETAFPV P1 Nano VRX (AR9311 + AR8030 over SDIO, stock board "c401",
 * hardware V2.3). Wiring from the unit's stock 2.0.8 device tree, startup
 * scripts and logs: radio reset GPIO23, SD I/O rail GPIO100, the P1 ADC key
 * ladder on channel 0, DSI to a Lontium LT9611EX HDMI bridge on I2C0 0x41
 * (interrupt GPIO94; reset GPIO96 is inferred from what stock exports).
 * Same SPL, A/B flash layout and CPU handoff as the P1 Air: fpvOS in the
 * bank stock is not running from, the stock firmware kept in the other.
 */
/dts-v1/;
#include "ar9311.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "BETAFPV P1 Nano VRX (AR9311)";
	compatible = "betafpv,p1-nano-vrx", "artosyn,proxima-9311";

	aliases {
		serial0 = &uart0;
		i2c0 = &i2c0;
	};

	chosen {
		stdout-path = "serial0:1152000n8";
		bootargs = "console=ttyS0,1152000 earlycon loglevel=7 mem=148M rdinit=/init";
	};

	/* The SPL reads this word at reset; bit 0 requests its USB loader. */
	reboot-scratch@a106138 {
		compatible = "syscon", "simple-mfd";
		reg = <0 0x0a106138 0 4>;
		reboot-mode {
			compatible = "syscon-reboot-mode";
			offset = <0>;
			mode-normal = <2>;
			mode-bootloader = <3>;
		};
	};

	/* Stock's ladder: the same levels and keys as the P1 goggles, under the
	 * goggles' name - the evdev device kestrel-gnd's P1 keypad opens. */
	p1-goggle-keys {
		compatible = "adc-keys";
		io-channels = <&adc 0>;
		io-channel-names = "buttons";
		poll-interval = <10>;
		keyup-threshold-microvolt = <0>;
		button-bind { label = "bind"; linux,code = <KEY_CONNECT>; press-threshold-microvolt = <200000>; };
		button-back { label = "back"; linux,code = <KEY_BACK>; press-threshold-microvolt = <400000>; };
		button-record { label = "record"; linux,code = <KEY_RECORD>; press-threshold-microvolt = <600000>; };
		button-up { label = "up"; linux,code = <KEY_UP>; press-threshold-microvolt = <800000>; };
		button-left { label = "left"; linux,code = <KEY_LEFT>; press-threshold-microvolt = <1000000>; };
		button-right { label = "right"; linux,code = <KEY_RIGHT>; press-threshold-microvolt = <1200000>; };
		button-enter { label = "enter"; linux,code = <KEY_ENTER>; press-threshold-microvolt = <1400000>; };
		button-down { label = "down"; linux,code = <KEY_DOWN>; press-threshold-microvolt = <1600000>; };
	};

	/* Stock: 256 MiB DRAM, 148 MiB for Linux (mem=148m), the rest media. */
	memory@20000000 {
		device_type = "memory";
		reg = <0 0x20000000 0 0x10000000>;
	};
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		codec_memory: media@29400000 {
			compatible = "shared-dma-pool";
			reg = <0 0x29400000 0 0x06b00000>;
			no-map;
		};
		loader@2ff00000 {
			reg = <0 0x2ff00000 0 0x00100000>;
			no-map;
		};
	};

	hdmi_connector {
		compatible = "hdmi-connector";
		type = "a";
		port {
			hdmi_in: endpoint {
				remote-endpoint = <&bridge_out>;
			};
		};
	};

	/* Stock start_ar813x_gnd.sh resets the radio on GPIO23. */
	radio_pwrseq: radio-pwrseq {
		compatible = "artosyn,ar8030-pwrseq";
		reset-gpios = <&gpio 23 GPIO_ACTIVE_LOW>;
	};
};

&cpu0 { enable-method = "ar-spin-table"; };
&cpu1 {
	enable-method = "ar-spin-table";
	cpu-release-addr = <0 0x00100000>;
};
&uart0 { status = "okay"; };
&usb {
	status = "okay";
	dr_mode = "peripheral";
};
&watchdog { status = "okay"; };

/* The SoC temperature, for the receiver's canopy (fpvOS ar9311_temp). Its
 * window overlaps the SAR ADC's (the keypad's channel 0): no supply channel
 * is given here, so it never samples the ADC behind the keypad driver. */
&soc_temp {
	status = "okay";
};
&adc { status = "okay"; };

&gpio {
	status = "okay";
	/* Stock adc.sh enables the keypad on GPIO97 before reading ADC0. */
	keypad-enable-hog {
		gpio-hog;
		gpios = <97 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "keypad-enable";
	};
	/* GPIO100 is the SD I/O rail (stock's "vqmmc sdmmc1", 3.3 V when high).
	 * Stock keeps it high.
	 */
	sd-io-rail-hog {
		gpio-hog;
		gpios = <100 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sd-io-rail";
	};
	/* Levels stock's video application leaves on lines 42 and 107
	 * (function on this board not identified), held the same way here.
	 */
	stock-42-hog {
		gpio-hog;
		gpios = <42 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "stock-42";
	};
	stock-107-hog {
		gpio-hog;
		gpios = <107 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "stock-107";
	};
};

/* Stock enables I2C0 (HDMI bridge) and I2C4 (nothing answers there).
 * I2C0 also has the battery-backed DS1307 at 0x68 that stock declares:
 * the system clock comes from it at boot, and SET_TIME writes it (UTC).
 */
&i2c0 {
	status = "okay";
	clock-frequency = <400000>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <300>;
	i2c-scl-falling-time-ns = <300>;

	rtc@68 {
		compatible = "dallas,ds1307";
		reg = <0x68>;
	};

	/* The bridge runs its own firmware: it follows the DSI input and
	 * does the DDC itself. The host resets it, asks it for hot-plug and
	 * the EDID, and turns the HDMI output on and off.
	 */
	bridge@41 {
		compatible = "lontium,lt9611ex";
		reg = <0x41>;
		reset-gpios = <&gpio 96 GPIO_ACTIVE_LOW>;
		/* GPIO94 is its interrupt line; the SoC GPIO driver has no
		 * interrupts yet, so the driver polls for hot-plug.
		 */
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				bridge_in: endpoint {
					remote-endpoint = <&dsi_out>;
				};
			};
			port@2 {
				reg = <2>;
				bridge_out: endpoint {
					remote-endpoint = <&hdmi_in>;
				};
			};
		};
	};
};

/* Stock's 1080p60 output: the CEA raster on four 928.8 Mbps lanes, as the
 * Ascent receiver's.
 */
&vo {
	status = "okay";
	artosyn,display-profile = "ascent-hdmi";
	port {
		vo_out: endpoint { remote-endpoint = <&dsi_in>; };
	};
};
&dsi {
	status = "okay";
	artosyn,display-profile = "ascent-hdmi";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			dsi_in: endpoint { remote-endpoint = <&vo_out>; };
		};
		port@1 {
			reg = <1>;
			dsi_out: endpoint { remote-endpoint = <&bridge_in>; };
		};
	};
};

/* The unit's own decoder blob is the same file as the P1 goggles'
 * (SHA-256 308b9635...), so the same package profile is used.
 */
&vpu {
	status = "okay";
	memory-region = <&codec_memory>;
	firmware-name = "artosyn/p1-goggle-chagall.bin";
};

&mmc_clocks {
	status = "okay";
	artosyn,clock-config = <0x87 2>, <0x80 0>;
};
/* AR8030 on SDIO. */
&mmc0 {
	status = "okay";
	clock-frequency = <100000000>;
	max-frequency = <50000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	broken-cd;
	no-mmc;
	no-sd;
	no-1-8-v;
	mmc-pwrseq = <&radio_pwrseq>;
};
/* SD card. */
&mmc1 {
	status = "okay";
	clock-frequency = <100000000>;
	max-frequency = <50000000>;
	card-detect-delay = <200>;
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-1-8-v;
	no-mmc;
	no-sdio;
};

/* P1 A/B layout. Bank 0 (kernel0/dtb0/userapp0) is fpvOS; bank 1 holds the
 * stock firmware the unit shipped running and is read-only here, as are the
 * SPL, the boot loaders and factory calibration. The updater switches banks
 * in boot-state (gpt0/gpt1) and keeps its state in usr_data.
 */
&qspi_clock { status = "okay"; };
&qspi {
	status = "okay";
	clocks = <&qspi_clock>;
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <25000000>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			partition@0 { label = "stock-spl"; reg = <0 0x100000>; read-only; };
			partition@100000 { label = "boot-state"; reg = <0x100000 0x80000>; };
			partition@180000 { label = "stock-vendor"; reg = <0x180000 0x80000>; read-only; };
			partition@200000 { label = "factory"; reg = <0x200000 0x600000>; read-only; };
			partition@800000 { label = "stock-bootloaders"; reg = <0x800000 0x240000>; read-only; };
			/* Both banks, under the stock names: an install picks the bank
			 * (fpvos-update: the one holding fpvOS, else the one not booted)
			 * and its checks, not the DT, keep the stock bank unwritten. */
			partition@a40000 { label = "kernel0"; reg = <0xa40000 0x600000>; };
			partition@1040000 { label = "kernel1"; reg = <0x1040000 0x600000>; };
			partition@1640000 { label = "dtb0"; reg = <0x1640000 0x60000>; };
			partition@16a0000 { label = "dtb1"; reg = <0x16a0000 0x60000>; };
			partition@1700000 { label = "userapp0"; reg = <0x1700000 0x2d00000>; };
			partition@4400000 { label = "userapp1"; reg = <0x4400000 0x2d00000>; };
			partition@7100000 { label = "usr_data"; reg = <0x7100000 0x600000>; };
		};
	};
};

/* Stock status chain: three GRB LEDs, encoded at 6.25 MHz in SPI mode 3. */
&spi1 {
	status = "okay";
	status-led@0 {
		compatible = "betafpv,p1-vrx-status-led";
		reg = <0>;
		spi-max-frequency = <6250000>;
		spi-cpol;
		spi-cpha;
	};
};

/* The supply (RX SUPPLY): SAR ADC channel 1 through a 100k/5.1k divider, as
 * stock reads it (arlink_fpv 2.0.8 hamingVrxGndGetVoltage: in_voltage1_input
 * / 0.048525). Through the ADC's own driver, which the keypad's channel 0
 * shares, so the two never sample at once; kestrel-gnd reads vin_hwmon. */
/ {
	vin_divider: vin-divider {
		compatible = "voltage-divider";
		io-channels = <&adc 1>;
		#io-channel-cells = <0>;
		output-ohms = <5100>;
		full-ohms = <105100>;
	};
	vin-hwmon {
		compatible = "iio-hwmon";
		io-channels = <&vin_divider>;
	};
};
