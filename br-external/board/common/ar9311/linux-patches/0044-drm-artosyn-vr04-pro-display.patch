--- /dev/null
+++ b/drivers/gpu/drm/artosyn/panel-gm8773c.c
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The display of the BETAFPV VR04 HD Pro goggles: a GM8773C on I2C between
+ * the SoC's DSI output and the panel. The SoC sends 1080p60 video only; the
+ * panel's init goes through the bridge, which is given each DSI packet over
+ * I2C and sends it to the panel in low-power mode.
+ *
+ * The sequence is stock's (libpn_gm8773c.so, see panel-gm8773c.h): the
+ * bridge's registers, the panel's packets one at a time, then one register
+ * that ends it. Stock runs it once the video output is up, so it runs in
+ * .enable. Stock has no power-down sequence and no brightness control for
+ * this display; neither is here.
+ *
+ * Written from the firmware alone: not run on a unit.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+#include "panel-gm8773c.h"
+
+/* A packet for the panel: its routing, its bytes, then the go. */
+#define GM8773C_LP_PORT		0xed
+#define GM8773C_LP_FLAGS	0xee
+#define GM8773C_LP_DATA		0xef
+#define GM8773C_LP_SEND		0xfb
+#define GM8773C_LP_SEND_GO	0xcc
+#define GM8773C_DONE		0xff
+
+struct gm8773c {
+	struct drm_panel	panel;
+	struct i2c_client	*client;
+	struct mipi_dsi_device	*dsi;
+};
+
+/* CEA-861 1080p60, stock's raster for this display. */
+static const struct drm_display_mode gm8773c_mode = {
+	.clock		= 148500,
+	.hdisplay	= 1920,
+	.hsync_start	= 1920 + 88,
+	.hsync_end	= 1920 + 88 + 44,
+	.htotal		= 1920 + 88 + 44 + 148,
+	.vdisplay	= 1080,
+	.vsync_start	= 1080 + 4,
+	.vsync_end	= 1080 + 4 + 5,
+	.vtotal		= 1080 + 4 + 5 + 36,
+	.flags		= DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+};
+
+static inline struct gm8773c *to_gm8773c(struct drm_panel *panel)
+{
+	return container_of(panel, struct gm8773c, panel);
+}
+
+static int gm8773c_enable(struct drm_panel *panel)
+{
+	struct gm8773c *ctx = to_gm8773c(panel);
+	struct i2c_client *client = ctx->client;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(gm8773c_regs); i++) {
+		ret = i2c_smbus_write_byte_data(client, gm8773c_regs[i].reg, gm8773c_regs[i].val);
+		if (ret)
+			goto fail;
+	}
+	for (i = 0; i < ARRAY_SIZE(gm8773c_panel_init); i++) {
+		const struct gm8773c_cmd *c = &gm8773c_panel_init[i];
+		const u8 packet[] = { c->type, c->cmd, c->param };
+
+		ret = i2c_smbus_write_byte_data(client, GM8773C_LP_PORT, 1);
+		if (!ret)
+			ret = i2c_smbus_write_byte_data(client, GM8773C_LP_FLAGS, 0);
+		if (!ret)
+			ret = i2c_smbus_write_i2c_block_data(client, GM8773C_LP_DATA,
+							     sizeof(packet), packet);
+		if (!ret)
+			ret = i2c_smbus_write_byte_data(client, GM8773C_LP_SEND,
+							GM8773C_LP_SEND_GO);
+		if (ret)
+			goto fail;
+		if (c->delay)
+			msleep(c->delay);
+	}
+	ret = i2c_smbus_write_byte_data(client, GM8773C_DONE, 1);
+	if (ret)
+		goto fail;
+	return 0;
+fail:
+	dev_err(&client->dev, "bridge did not take its init: %d\n", ret);
+	return ret;
+}
+
+static int gm8773c_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct drm_display_mode *mode = drm_mode_duplicate(connector->dev, &gm8773c_mode);
+
+	if (!mode)
+		return -ENOMEM;
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static const struct drm_panel_funcs gm8773c_funcs = {
+	.enable		= gm8773c_enable,
+	.get_modes	= gm8773c_get_modes,
+};
+
+static int gm8773c_probe(struct i2c_client *client)
+{
+	const struct mipi_dsi_device_info info = { "gm8773c", 0, NULL };
+	struct device *dev = &client->dev;
+	struct device_node *host_node;
+	struct mipi_dsi_host *host;
+	struct gm8773c *ctx;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA |
+				     I2C_FUNC_SMBUS_WRITE_I2C_BLOCK))
+		return -ENODEV;
+
+	host_node = of_graph_get_remote_node(dev->of_node, 0, -1);
+	if (!host_node)
+		return dev_err_probe(dev, -ENODEV, "no DSI host in the graph\n");
+	host = of_find_mipi_dsi_host_by_node(host_node);
+	of_node_put(host_node);
+	if (!host)
+		return dev_err_probe(dev, -EPROBE_DEFER, "failed to find dsi host\n");
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->client = client;
+	i2c_set_clientdata(client, ctx);
+
+	drm_panel_init(&ctx->panel, dev, &gm8773c_funcs, DRM_MODE_CONNECTOR_DSI);
+	drm_panel_add(&ctx->panel);
+
+	ctx->dsi = devm_mipi_dsi_device_register_full(dev, host, &info);
+	if (IS_ERR(ctx->dsi)) {
+		ret = dev_err_probe(dev, PTR_ERR(ctx->dsi), "failed to create dsi device\n");
+		goto remove;
+	}
+	ctx->dsi->lanes = 4;
+	ctx->dsi->format = MIPI_DSI_FMT_RGB888;
+	ctx->dsi->mode_flags = MIPI_DSI_MODE_VIDEO;
+
+	ret = devm_mipi_dsi_attach(dev, ctx->dsi);
+	if (ret) {
+		dev_err_probe(dev, ret, "mipi_dsi_attach failed\n");
+		goto remove;
+	}
+	return 0;
+remove:
+	drm_panel_remove(&ctx->panel);
+	return ret;
+}
+
+static void gm8773c_remove(struct i2c_client *client)
+{
+	struct gm8773c *ctx = i2c_get_clientdata(client);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id gm8773c_of_match[] = {
+	{ .compatible = "betafpv,vr04-pro-display" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, gm8773c_of_match);
+
+static struct i2c_driver gm8773c_driver = {
+	.probe	= gm8773c_probe,
+	.remove	= gm8773c_remove,
+	.driver = {
+		.name		= "panel-gm8773c",
+		.of_match_table	= gm8773c_of_match,
+	},
+};
+module_i2c_driver(gm8773c_driver);
+
+MODULE_DESCRIPTION("BETAFPV VR04 HD Pro display (GM8773C DSI bridge and its panel)");
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/gpu/drm/artosyn/panel-gm8773c.h
@@ -0,0 +1,273 @@
