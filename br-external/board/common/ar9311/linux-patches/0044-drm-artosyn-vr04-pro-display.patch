+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/betafpv,vr04-pro-display.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: BETAFPV VR04 HD Pro display (GM8773C DSI bridge and its panel)
+maintainers:
+  - fpvOS contributors
+description:
+  A GM8773C on I2C between a four-lane DSI output and the goggles' 1080p
+  panel. The host sends video only; the driver gives the bridge the panel's
+  init over I2C.
+allOf:
+  - $ref: panel-common.yaml#
+properties:
+  compatible:
+    const: betafpv,vr04-pro-display
+  reg:
+    const: 0x57
+  port: true
+required:
+  - compatible
+  - reg
+  - port
+unevaluatedProperties: false
