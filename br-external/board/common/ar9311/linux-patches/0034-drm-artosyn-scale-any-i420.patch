+		struct drm_plane_state *s = vo->pipe.plane.state;
+
+		/* A new source size (720p, 864p, 1080p video) reprograms the scaler,
+		 * whose registers must not change while a frame scans out. Rather
+		 * than a modeset (HDMI drops and the screen resyncs), this flip
+		 * waits for the next frame-start interrupt and is written there;
+		 * its event is kept with it and goes out one interrupt later.
