 	vo->cur_cfg |= VO_MAIN_START;
 	writel(vo->cur_cfg, vo->regs + VO_MAIN_CTRL);
@@ -312,10 +333,32 @@
 	drm_crtc_vblank_on(&pipe->crtc);
 }
 
+/* Ends a parked flip wherever it stands: nothing more is written for it and
+ * its event goes out now. True when its vblank reference is to be dropped
+ * (outside the lock). Event lock held.
+ */
+static bool ar_vo_geom_end(struct ar_vo *vo)
+{
+	bool held = vo->geom_held;
+
+	if (vo->geom_event)
+		drm_crtc_send_vblank_event(&vo->pipe.crtc, vo->geom_event);
+	vo->geom_event = NULL;
+	vo->geom_pending = NULL;
+	vo->geom_held = false;
+	return held;
+}
+
 static void ar_vo_pipe_disable(struct drm_simple_display_pipe *pipe)
 {
 	struct ar_vo *vo = to_ar_vo(pipe->crtc.dev);
+	bool put;
 
+	spin_lock_irq(&vo->drm.event_lock);
+	put = ar_vo_geom_end(vo);
+	spin_unlock_irq(&vo->drm.event_lock);
+	if (put)
+		drm_crtc_vblank_put(&pipe->crtc);
 	writel(0, vo->regs + VO_OVL_CONFIG);
 	drm_crtc_vblank_off(&pipe->crtc);
 	writel(0, vo->regs + VO_MAIN_CTRL);
@@ -332,14 +375,36 @@
 	struct drm_device *dev = state->dev;
