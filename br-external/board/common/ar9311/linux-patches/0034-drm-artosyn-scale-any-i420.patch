+	u32				cur_src;	/* programmed source size, w | h << 16 */
+	/* A flip to a new source size (holds a vblank reference while geom_held).
+	 * It is written at the next frame start (geom_pending until then) and its
+	 * event, kept here rather than armed, goes out at the frame start after
+	 * that one, once the new picture is the one scanned. No other commit can
+	 * start before the event is sent. Under the event lock.
+	 */
+	struct drm_plane_state		*geom_pending;
+	struct drm_pending_vblank_event	*geom_event;
+	bool				geom_held;
 	enum ar_display_profile		profile;
