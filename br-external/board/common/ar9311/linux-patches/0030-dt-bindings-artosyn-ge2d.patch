From: fpvOS contributors
Subject: [PATCH] dt-bindings: artosyn: describe GE2D and shared DC registers

Describe the offscreen compositor and shared clock register. Allow a
separate display QoS resource outside the compositor register window.

---
diff --git a/Documentation/devicetree/bindings/display/artosyn,ar9311-vo.yaml b/Documentation/devicetree/bindings/display/artosyn,ar9311-vo.yaml
--- a/Documentation/devicetree/bindings/display/artosyn,ar9311-vo.yaml
+++ b/Documentation/devicetree/bindings/display/artosyn,ar9311-vo.yaml
@@ -26,7 +26,8 @@
     const: artosyn,ar9311-vo
 
   reg:
-    maxItems: 3
+    minItems: 3
+    maxItems: 4
 
   artosyn,display-profile:
     $ref: /schemas/types.yaml#/definitions/string
@@ -34,10 +35,16 @@
     description: Explicit selection of the supported fixed output setup.
 
   reg-names:
+    minItems: 3
     items:
       - const: vo
       - const: pixel-clock
       - const: dc-crg
+      - const: qos
+
+  artosyn,dc-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Shared DC clock/reset register, also used by GE2D.
 
   interrupts:
     maxItems: 1
diff --git a/Documentation/devicetree/bindings/mfd/artosyn,ar9311-dc-crg.yaml b/Documentation/devicetree/bindings/mfd/artosyn,ar9311-dc-crg.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/artosyn,ar9311-dc-crg.yaml
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/artosyn,ar9311-dc-crg.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Artosyn AR9311 shared display clock and reset register
+
+maintainers:
+  - mh1412 <mh1412@users.noreply.github.com>
+
+properties:
+  compatible:
+    items:
+      - const: artosyn,ar9311-dc-crg
+      - const: syscon
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/misc/artosyn,ar9311-ge2d.yaml b/Documentation/devicetree/bindings/misc/artosyn,ar9311-ge2d.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/misc/artosyn,ar9311-ge2d.yaml
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/artosyn,ar9311-ge2d.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Artosyn AR9311 offscreen graphics compositor
+
+maintainers:
+  - mh1412 <mh1412@users.noreply.github.com>
+
+properties:
+  compatible:
+    const: artosyn,ar9311-ge2d
+  reg:
+    maxItems: 1
+  interrupts:
+    maxItems: 1
+  artosyn,dc-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Shared display clock and reset register.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - artosyn,dc-syscon
+
+additionalProperties: false
