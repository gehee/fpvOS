From: fpvOS contributors
Subject: [PATCH] clk: initialize AR9311 QSPI independently of stock Linux

Use the vendor identification fallback rate for conservative PIO NAND access.
U-Boot leaves 150 MHz selected on P1, which corrupts the untrained READID.
The independent provider is available before loading camera modules.

--- a/drivers/spi/spi-ar9301.c
+++ b/drivers/spi/spi-ar9301.c
@@ -28,6 +28,8 @@
 
 /* Register block at "qspi_base". */
 #define AR9301_CTRL		0x04	/* mode control; bits 17/19 (uncertain) */
+#define AR9301_TIMING		0x08
+#define AR9301_SAMPLE_DELAY	GENMASK(13, 10)
 #define AR9301_LANE		0x10	/* per-phase bus-width + enable; written last */
 #define AR9301_CMD		0x14	/* opcode + addr/dummy counts + direction */
 #define AR9301_ADDR		0x18	/* 32-bit flash address */
@@ -370,10 +372,17 @@
 	if (IS_ERR(qspi->base))
 		return PTR_ERR(qspi->base);
 
-	/* QSPI pinmux/source setup is inherited from the bootloader. */
+	/* Pinmux is inherited; the source clock is owned by CCF. */
 	qspi->clk = devm_clk_get_optional_enabled(dev, NULL);
 	if (IS_ERR(qspi->clk))
 		return dev_err_probe(dev, PTR_ERR(qspi->clk), "failed to get clock\n");
+
+	/* The 25 MHz PIO clock needs no inherited high-speed sample delay. */
+	if (qspi->clk && clk_get_rate(qspi->clk) <= 25000000) {
+		writel(readl(qspi->base + AR9301_TIMING) & ~AR9301_SAMPLE_DELAY,
+		       qspi->base + AR9301_TIMING);
+		ctlr->max_speed_hz = clk_get_rate(qspi->clk);
+	}
 
 	/* Quiesce the control/IRQ/DMA registers at probe. */
 	writel(0, qspi->base + AR9301_IRQ_EN);
--- a/drivers/clk/Kconfig
+++ b/drivers/clk/Kconfig
@@ -593,3 +593,10 @@
 	  Kunit test for the clk-fractional-divider type.
 
 endif
+
+config COMMON_CLK_AR9311_QSPI
+	bool "Artosyn AR9311 recovery QSPI clock"
+	depends on OF && (ARM64 || COMPILE_TEST)
+	help
+	  Initialize the QSPI source and divider independently of stock Linux.
+	  Uses the conservative 25 MHz PIO rate without changing shared PLLs.
--- a/drivers/clk/Makefile
+++ b/drivers/clk/Makefile
@@ -169,3 +169,5 @@
 obj-y					+= xilinx/
 obj-$(CONFIG_ARCH_ZYNQ)			+= zynq/
 obj-$(CONFIG_COMMON_CLK_ZYNQMP)         += zynqmp/
+
+obj-$(CONFIG_COMMON_CLK_AR9311_QSPI) += clk-ar9311-qspi.o
--- /dev/null
+++ b/drivers/clk/clk-ar9311-qspi.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* AR9311 QSPI recovery clock. Only the low halfword belongs to QSPI;
+ * the upper half is I2S. The camera CGU exposes QSPI as read-only.
+ * Source 2 is the fixed 100 MHz tap; divider 3 gives a conservative
+ * 25 MHz without the board-specific training required at higher rates.
+ * Layout and rate follow the vendor QSPI identification fallback.
+ */
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+struct ar_qspi_clock {
+	struct clk_hw hw;
+	void __iomem *reg;
+};
+
+static int ar_qspi_prepare(struct clk_hw *hw)
+{
+	struct ar_qspi_clock *clock = container_of(hw, struct ar_qspi_clock, hw);
+	u16 value = readw(clock->reg);
+
+	value = (value & ~0x77f) | 0x1203;
+	writew(value, clock->reg);
+	return readw(clock->reg) == value ? 0 : -EIO;
+}
+
+static unsigned long ar_qspi_rate(struct clk_hw *hw, unsigned long parent)
+{
+	struct ar_qspi_clock *clock = container_of(hw, struct ar_qspi_clock, hw);
+	u16 value = readw(clock->reg);
+	unsigned long source;
+
+	switch ((value >> 8) & 7) {
+	case 2: source = 100000000; break;
+	case 4: source = 150000000; break;
+	default: return 0;
+	}
+	return source / ((value & 0x7f) + 1);
+}
+
+static const struct clk_ops ar_qspi_ops = {
+	.prepare = ar_qspi_prepare,
+	.recalc_rate = ar_qspi_rate,
+};
+
+static int ar_qspi_clock_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ar_qspi_clock *clock;
+	struct clk_init_data init = {
+		.name = "ar9311-qspi",
+		.ops = &ar_qspi_ops,
+		.flags = CLK_GET_RATE_NOCACHE,
+	};
+	int ret;
+
+	clock = devm_kzalloc(dev, sizeof(*clock), GFP_KERNEL);
+	if (!clock)
+		return -ENOMEM;
+	clock->reg = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(clock->reg))
+		return PTR_ERR(clock->reg);
+	clock->hw.init = &init;
+	ret = devm_clk_hw_register(dev, &clock->hw);
+	if (ret)
+		return ret;
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, &clock->hw);
+}
+
+static const struct of_device_id ar_qspi_match[] = {
+	{ .compatible = "artosyn,ar9311-qspi-clock" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ar_qspi_match);
+static struct platform_driver ar_qspi_driver = {
+	.probe = ar_qspi_clock_probe,
+	.driver = { .name = "ar9311-qspi-clock", .of_match_table = ar_qspi_match },
+};
+module_platform_driver(ar_qspi_driver);
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/artosyn,ar9311-qspi-clock.yaml
@@ -0,0 +1,32 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/artosyn,ar9311-qspi-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: Artosyn AR9311 QSPI source clock
+maintainers:
+  - fpvOS contributors <dev@fpvos.local>
+description: |
+  The low halfword of CGU register 0xa104034 controls QSPI. The upper
+  halfword belongs to I2S and is not part of this resource. The provider
+  selects the fixed 100 MHz tap divided by four for untrained PIO access.
+  It does not program PLLs or the adjacent I2S clock.
+properties:
+  compatible:
+    const: artosyn,ar9311-qspi-clock
+  reg:
+    maxItems: 1
+  '#clock-cells':
+    const: 0
+required:
+  - compatible
+  - reg
+  - '#clock-cells'
+additionalProperties: false
+examples:
+  - |
+    clock-controller@a104034 {
+        compatible = "artosyn,ar9311-qspi-clock";
+        reg = <0x0a104034 2>;
+        #clock-cells = <0>;
+    };
