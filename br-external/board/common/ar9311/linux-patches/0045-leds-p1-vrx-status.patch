From: fpvOS contributors
Subject: [PATCH] leds: add opt-in P1 VRX SPI status chain

--- /dev/null
+++ b/drivers/leds/rgb/leds-p1-vrx.c
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* P1 VRX status chain: three GRB LEDs, stock SPI encoding at 6.25 MHz. */
+#include <linux/led-class-multicolor.h>
+#include <linux/module.h>
+#include <linux/spi/spi.h>
+
+struct p1_led {
+	struct spi_device *spi;
+	struct led_classdev_mc mc;
+	struct mc_subled colors[3];
+	u8 wire[72];
+};
+
+static int p1_led_set(struct led_classdev *cdev, enum led_brightness value)
+{
+	struct led_classdev_mc *mc = lcdev_to_mccdev(cdev);
+	struct p1_led *led = container_of(mc, struct p1_led, mc);
+	static const unsigned int grb[] = { 1, 0, 2 };
+	unsigned int n, color, bit, pos = 0;
+
+	led_mc_calc_color_components(mc, value);
+	for (n = 0; n < 3; n++)
+		for (color = 0; color < 3; color++)
+			for (bit = 0; bit < 8; bit++)
+				led->wire[pos++] = mc->subled_info[grb[color]].brightness &
+					BIT(7 - bit) ? 0xfc : 0xc0;
+	return spi_write(led->spi, led->wire, sizeof(led->wire));
+}
+
+static int p1_led_probe(struct spi_device *spi)
+{
+	struct p1_led *led;
+	int ret;
+
+	led = devm_kzalloc(&spi->dev, sizeof(*led), GFP_KERNEL);
+	if (!led)
+		return -ENOMEM;
+	spi->mode = SPI_MODE_3;
+	spi->bits_per_word = 8;
+	spi->max_speed_hz = 6250000;
+	ret = spi_setup(spi);
+	if (ret)
+		return ret;
+	led->spi = spi;
+	led->colors[0].color_index = LED_COLOR_ID_RED;
+	led->colors[1].color_index = LED_COLOR_ID_GREEN;
+	led->colors[2].color_index = LED_COLOR_ID_BLUE;
+	led->mc.num_colors = ARRAY_SIZE(led->colors);
+	led->mc.subled_info = led->colors;
+	led->mc.led_cdev.name = "fpvos:status";
+	led->mc.led_cdev.max_brightness = 255;
+	led->mc.led_cdev.brightness_set_blocking = p1_led_set;
+	spi_set_drvdata(spi, led);
+	ret = p1_led_set(&led->mc.led_cdev, LED_OFF);
+	if (ret)
+		return ret;
+	return devm_led_classdev_multicolor_register(&spi->dev, &led->mc);
+}
+
+static void p1_led_shutdown(struct spi_device *spi)
+{
+	struct p1_led *led = spi_get_drvdata(spi);
+
+	p1_led_set(&led->mc.led_cdev, LED_OFF);
+}
+
+static const struct of_device_id p1_led_of_match[] = {
+	{ .compatible = "betafpv,p1-vrx-status-led" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, p1_led_of_match);
+static const struct spi_device_id p1_led_ids[] = {
+	{ "p1-vrx-status-led" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, p1_led_ids);
+static struct spi_driver p1_led_driver = {
+	.driver = { .name = "p1-vrx-status-led", .of_match_table = p1_led_of_match },
+	.probe = p1_led_probe,
+	.remove = p1_led_shutdown,
+	.shutdown = p1_led_shutdown,
+	.id_table = p1_led_ids,
+};
+module_spi_driver(p1_led_driver);
+MODULE_DESCRIPTION("BETAFPV P1 VRX SPI status LEDs");
+MODULE_LICENSE("GPL");
--- a/drivers/leds/rgb/Kconfig
+++ b/drivers/leds/rgb/Kconfig
@@ -1,6 +1,15 @@
 # SPDX-License-Identifier: GPL-2.0
 
 if LEDS_CLASS_MULTICOLOR
+
+config LEDS_P1_VRX
+	tristate "BETAFPV P1 VRX SPI status LEDs"
+	depends on SPI
+	help
+	  Three GRB LEDs driven together using the P1 VRX's stock SPI
+	  encoding. Exposes one multicolor status LED. Only binds to an
+	  explicitly described betafpv,p1-vrx-status-led device.
+
 
 config LEDS_GROUP_MULTICOLOR
 	tristate "LEDs group multi-color support"
--- a/drivers/leds/rgb/Makefile
+++ b/drivers/leds/rgb/Makefile
@@ -6,3 +6,4 @@
 obj-$(CONFIG_LEDS_PWM_MULTICOLOR)	+= leds-pwm-multicolor.o
 obj-$(CONFIG_LEDS_QCOM_LPG)		+= leds-qcom-lpg.o
 obj-$(CONFIG_LEDS_MT6370_RGB)		+= leds-mt6370-rgb.o
+obj-$(CONFIG_LEDS_P1_VRX) += leds-p1-vrx.o
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/betafpv,p1-vrx-status-led.yaml
@@ -0,0 +1,37 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/betafpv,p1-vrx-status-led.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: BETAFPV P1 VRX status LED chain
+
+maintainers:
+  - fpvOS contributors <dev@fpvos.local>
+
+description: |
+  Three GRB status LEDs driven together through the AR9311 SPI controller.
+  The board protocol uses eight SPI bits per LED bit (0xc0 for zero and
+  0xfc for one), at 6.25 MHz with SPI mode 3.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: betafpv,p1-vrx-status-led
+  reg:
+    maxItems: 1
+  spi-max-frequency:
+    const: 6250000
+  spi-cpol: true
+  spi-cpha: true
+
+required:
+  - compatible
+  - reg
+  - spi-max-frequency
+  - spi-cpol
+  - spi-cpha
+
+unevaluatedProperties: false
