From: fpvOS contributors <dev@fpvos.local>
Subject: [PATCH] pwm: add Artosyn AR9311 counter-based PWM provider

Based on the GPL-2.0 register reconstruction in Missing-Lynk/ml-kernel
e3885c6394a7025eacd3a23f473276d9823beb25. Keep board wiring and feedback
policy in consumers. Reject unsupported polarity and out-of-range periods;
stop the affected channel before changing its separate high/low counters.

Upstream: not submitted
Signed-off-by: fpvOS contributors <dev@fpvos.local>

--- /dev/null
+++ b/drivers/pwm/pwm-artosyn.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Artosyn AR9301/AR9311 PWM controller.
+ * Register map based on Missing-Lynk/ml-kernel artosyn_pwm.c at
+ * e3885c6394a7025eacd3a23f473276d9823beb25 (GPL-2.0).
+ *
+ * Eight channels have separate low/high cycle counters. Board wiring and
+ * tone/backlight policy belong to the consumer, not this provider.
+ * Pinmux and the peripheral clock gates are inherited from boot firmware.
+ */
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pwm.h>
+
+#define AR_PWM_OFF(n)		((n) * 0x14)
+#define AR_PWM_CTRL(n)		((n) * 0x14 + 8)
+#define AR_PWM_ON(n)		(0xb0 + (n) * 4)
+#define AR_PWM_ENABLE		0x0b
+#define AR_PWM_CHANNELS		8
+
+struct ar_pwm {
+	void __iomem *base;
+	struct clk *clk;
+};
+
+static void ar_pwm_disable(struct pwm_chip *chip, struct pwm_device *pwm)
+{
+	struct ar_pwm *priv = pwmchip_get_drvdata(chip);
+	void __iomem *ctrl = priv->base + AR_PWM_CTRL(pwm->hwpwm);
+
+	writel(readl(ctrl) & ~AR_PWM_ENABLE, ctrl);
+}
+
+static int ar_pwm_apply(struct pwm_chip *chip, struct pwm_device *pwm,
+			const struct pwm_state *state)
+{
+	struct ar_pwm *priv = pwmchip_get_drvdata(chip);
+	unsigned long rate = clk_get_rate(priv->clk);
+	unsigned int n = pwm->hwpwm;
+	u64 period, duty;
+	u32 ctrl;
+
+	if (state->polarity != PWM_POLARITY_NORMAL)
+		return -EINVAL;
+
+	/* Disabling must work even for an unconfigured channel. */
+	if (!state->enabled) {
+		ar_pwm_disable(chip, pwm);
+		return 0;
+	}
+
+	if (!rate)
+		return -EINVAL;
+	/* Bound the total count as well as the multiplication below. */
+	if (state->period > div_u64((u64)U32_MAX * NSEC_PER_SEC, rate))
+		return -ERANGE;
+	period = div_u64(state->period * rate, NSEC_PER_SEC);
+	duty = div_u64(state->duty_cycle * rate, NSEC_PER_SEC);
+	if (!period || duty > period)
+		return -ERANGE;
+
+	/* There is no atomic latch: stop this channel before changing counters. */
+	ctrl = readl(priv->base + AR_PWM_CTRL(n)) & ~AR_PWM_ENABLE;
+	writel(ctrl, priv->base + AR_PWM_CTRL(n));
+	writel(period - duty, priv->base + AR_PWM_OFF(n));
+	writel(duty, priv->base + AR_PWM_ON(n));
+	writel(ctrl | AR_PWM_ENABLE, priv->base + AR_PWM_CTRL(n));
+	return 0;
+}
+
+static int ar_pwm_get_state(struct pwm_chip *chip, struct pwm_device *pwm,
+			    struct pwm_state *state)
+{
+	struct ar_pwm *priv = pwmchip_get_drvdata(chip);
+	unsigned long rate = clk_get_rate(priv->clk);
+	unsigned int n = pwm->hwpwm;
+	u32 off, on;
+
+	if (!rate)
+		return -EINVAL;
+	off = readl(priv->base + AR_PWM_OFF(n));
+	on = readl(priv->base + AR_PWM_ON(n));
+	/* Round up so reapplying a read state preserves its cycle counts. */
+	state->period = DIV_ROUND_UP_ULL(((u64)off + on) * NSEC_PER_SEC, rate);
+	state->duty_cycle = DIV_ROUND_UP_ULL((u64)on * NSEC_PER_SEC, rate);
+	state->polarity = PWM_POLARITY_NORMAL;
+	state->enabled = (readl(priv->base + AR_PWM_CTRL(n)) & AR_PWM_ENABLE) ==
+			 AR_PWM_ENABLE;
+	return 0;
+}
+
+static const struct pwm_ops ar_pwm_ops = {
+	.apply = ar_pwm_apply,
+	.get_state = ar_pwm_get_state,
+	.free = ar_pwm_disable,
+};
+
+static int ar_pwm_probe(struct platform_device *pdev)
+{
+	struct pwm_chip *chip;
+	struct ar_pwm *priv;
+
+	chip = devm_pwmchip_alloc(&pdev->dev, AR_PWM_CHANNELS, sizeof(*priv));
+	if (IS_ERR(chip))
+		return PTR_ERR(chip);
+	priv = pwmchip_get_drvdata(chip);
+	priv->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+	priv->clk = devm_clk_get_enabled(&pdev->dev, NULL);
+	if (IS_ERR(priv->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->clk), "clock unavailable\n");
+	if (!clk_get_rate(priv->clk))
+		return dev_err_probe(&pdev->dev, -EINVAL, "zero clock rate\n");
+	chip->ops = &ar_pwm_ops;
+	return devm_pwmchip_add(&pdev->dev, chip);
+}
+
+static const struct of_device_id ar_pwm_match[] = {
+	{ .compatible = "artosyn,ar9301-pwm" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ar_pwm_match);
+
+static struct platform_driver ar_pwm_driver = {
+	.probe = ar_pwm_probe,
+	.driver = {
+		.name = "artosyn-pwm",
+		.of_match_table = ar_pwm_match,
+	},
+};
+module_platform_driver(ar_pwm_driver);
+
+MODULE_DESCRIPTION("Artosyn AR9301/AR9311 PWM controller");
+MODULE_LICENSE("GPL");
--- a/drivers/pwm/Kconfig
+++ b/drivers/pwm/Kconfig
@@ -31,0 +32,10 @@
+config PWM_ARTOSYN
+	tristate "Artosyn AR9301/AR9311 PWM support"
+	depends on OF && COMMON_CLK && (ARM64 || COMPILE_TEST)
+	help
+	  Eight-channel PWM controller with independent high/low counters.
+	  The driver is shared by board-specific beeper and backlight consumers.
+	  Only normal polarity is supported. Pinmux and clock gates must
+	  already be configured by boot firmware.
+	  To build as a module, choose M; the module is called pwm-artosyn.
+
--- a/drivers/pwm/Makefile
+++ b/drivers/pwm/Makefile
@@ -75,3 +75,4 @@
 obj-$(CONFIG_PWM_VISCONTI)	+= pwm-visconti.o
 obj-$(CONFIG_PWM_VT8500)	+= pwm-vt8500.o
 obj-$(CONFIG_PWM_XILINX)	+= pwm-xilinx.o
+obj-$(CONFIG_PWM_ARTOSYN)		+= pwm-artosyn.o
