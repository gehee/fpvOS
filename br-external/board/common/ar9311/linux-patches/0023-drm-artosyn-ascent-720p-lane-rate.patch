From: fpvOS contributors <dev@fpvos.local>
Subject: [PATCH] drm: artosyn: match the Ascent 720p transport clock and raster

Using the 1080p lane rate for 720p required a 3440-pixel internal line
with a short active burst and long blanking. Resolution changes could
produce duplicated vertical columns across both the video and UI planes,
also on a directly connected HDMI monitor.

Use 464.4 Mbps lanes for 720p and the corresponding vendor D-PHY timing.
The shared MIPI PLL also halves the display-controller pixel clock to
77.4 MHz. Match its 1720 x 750 raster with the DSI line's 1290 byte
clocks, and retain the existing 1080p transport unchanged.

The timing values follow the vendor PHY calculations; evaluating those
calculations at the existing 1080p lane rate reproduces its PHY table.
Only the opt-in Ascent 60 Hz profile permits the new mode.

Upstream: not submitted
Signed-off-by: fpvOS contributors <dev@fpvos.local>

---
diff --git a/drivers/gpu/drm/artosyn/artosyn_dsi.c b/drivers/gpu/drm/artosyn/artosyn_dsi.c
--- a/drivers/gpu/drm/artosyn/artosyn_dsi.c
+++ b/drivers/gpu/drm/artosyn/artosyn_dsi.c
@@ -4,8 +4,8 @@
  * Adapted from Missing-Lynk/ml-kernel e3885c6394a7025eacd3a23f473276d9823beb25.
  * Ascent profiles use the validated vendor lane clock and D-PHY register table.
  * Four-lane RGB888 sync-event video supports CEA-16 and optionally CEA-4.
- * D-PHY timing and PLL are fixed (~928.8 Mbps/lane); generic non-burst host
- * horizontal timings need overriding to match the selected profile's internal raster.
+ * Each mode uses a matched D-PHY, lane rate and internal DC raster. The
+ * non-burst host timing overrides are expressed in actual lane-byte clocks.
  */
 
 #include <linux/clk.h>
@@ -52,6 +52,31 @@
 	{ 0x3a0, 0x00000200 }, { 0x3a4, 0x00008000 },
 };
 
+
+/* Vendor D-PHY timing for the 464.4 Mbps 720p lane rate. */
+static const struct { u16 off; u32 val; } ar_dphy_ascent_720[] = {
+	{ 0x2d0, 0x00001b34 },
+	{ 0x2d8, 0x11040600 },
+	{ 0x2dc, 0x0908150a },
+	{ 0x2e4, 0x00000009 },
+	{ 0x2f4, 0x08050600 },
+	{ 0x2f8, 0x00000908 },
+	{ 0x2fc, 0x0021091b },
+	{ 0x304, 0x00000009 },
+	{ 0x310, 0x08050600 },
+	{ 0x314, 0x00000908 },
+	{ 0x330, 0x00001b34 },
+	{ 0x338, 0x11040600 },
+	{ 0x33c, 0x0908150a },
+	{ 0x344, 0x00000009 },
+	{ 0x354, 0x08050600 },
+	{ 0x358, 0x00000908 },
+	{ 0x35c, 0x0021091b },
+	{ 0x364, 0x00000009 },
+	{ 0x370, 0x08050600 },
+	{ 0x374, 0x00000908 },
+};
+
 static const struct { u16 off; u32 val; } ar_dsi_vid_ascent[] = {
 	{ 0x08, 0x812 },
 	{ 0x48, 44 },
@@ -72,13 +97,15 @@
 };
 
 #define AR_DSI_MIPI_PLL_DIV	0x044e7f72
+/* Inverse Q8.24 divider: doubling halves the 928.8 Mbps lane rate. */
 
 static int ar_dsi_phy_init(void *priv)
 {
 	struct ar_dsi *dsi = priv;
 	unsigned int i;
 
-	writel(AR_DSI_MIPI_PLL_DIV, dsi->base + 0x2c0);
+	writel(dsi->mode_720 ? AR_DSI_MIPI_PLL_DIV * 2 : AR_DSI_MIPI_PLL_DIV,
+	       dsi->base + 0x2c0);
 
 	for (i = 0; i < ARRAY_SIZE(ar_dphy_ascent); i++)
 		writel(ar_dphy_ascent[i].val, dsi->base + ar_dphy_ascent[i].off);
@@ -88,9 +115,12 @@
 		writel(ar_dsi_vid_ascent[i].val, dsi->base + ar_dsi_vid_ascent[i].off);
 
 	if (dsi->mode_720) {
-		writel(40, dsi->base + 0x48);
-		writel(220, dsi->base + 0x4c);
-		writel(2580, dsi->base + 0x50);
+		for (i = 0; i < ARRAY_SIZE(ar_dphy_ascent_720); i++)
+			writel(ar_dphy_ascent_720[i].val,
+			       dsi->base + ar_dphy_ascent_720[i].off);
+		writel(20, dsi->base + 0x48);
+		writel(110, dsi->base + 0x4c);
+		writel(1290, dsi->base + 0x50);
 	}
 	writel(dsi->lanes - 1, dsi->base + DSI_PHY_IF_CFG);
 	writel(0xd, dsi->base + DSI_PHY_RSTZ);
@@ -112,7 +142,7 @@
 			   mode->vdisplay != 1080)))
 		return -EINVAL;
 	dsi->mode_720 = mode_720;
-	*lane_mbps = 929;
+	*lane_mbps = mode_720 ? 465 : 929;
 	return 0;
 }
 
diff --git a/drivers/gpu/drm/artosyn/artosyn_vo.c b/drivers/gpu/drm/artosyn/artosyn_vo.c
--- a/drivers/gpu/drm/artosyn/artosyn_vo.c
+++ b/drivers/gpu/drm/artosyn/artosyn_vo.c
@@ -249,13 +249,13 @@
 	writel(0, vo->regs + VO_MAIN_CTRL);
 	writel(readl(vo->regs + VO_GLOBAL) & ~VO_GLOBAL_AXI_EN, vo->regs + VO_GLOBAL);
 
-	/* Keep the validated ~154.8 MHz internal pixel clock. At 720p,
-	 * 3440 x 750 internal pixels preserve ~60 Hz with longer blanking.
-	 * The DSI/PCR bridge emits standard CEA-4/16 HDMI timing.
+	/* The shared MIPI PLL supplies ~154.8 MHz at 1080p and ~77.4 MHz
+	 * at 720p. Match the internal raster to the selected lane rate:
+	 * 2293 x 1125 or 1720 x 750. DSI/PCR emits standard CEA-16/4 timing.
 	 */
-	writel(mode->hdisplay == 1280 ? (3440 << 16) | 1280 : 0x08f50780,
+	writel(mode->hdisplay == 1280 ? (1720 << 16) | 1280 : 0x08f50780,
 	       vo->regs + VO_H_ACT_FP);
-	writel(mode->hdisplay == 1280 ? VO_SYNC_VALID | (3147 << 15) | 3094 : 0x441807f5,
+	writel(mode->hdisplay == 1280 ? VO_SYNC_VALID | (1574 << 15) | 1547 : 0x441807f5,
 	       vo->regs + VO_H_SA_BP);
 	writel((mode->vtotal << 16) | mode->vdisplay, vo->regs + VO_V_ACT_FP);
 	writel(VO_SYNC_VALID | (mode->vsync_end << 15) | mode->vsync_start, vo->regs + VO_V_SA_BP);
