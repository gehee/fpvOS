+static struct vb2_v4l2_buffer *wave5_vpu_enc_active_src_buf(struct vpu_instance *inst)
+{
+	struct v4l2_m2m_ctx *m2m_ctx = inst->v4l2_fh.m2m_ctx;
+	struct vb2_buffer *vb;
+
+	if (inst->active_enc_src_idx < 0)
+		return NULL;
+
+	vb = vb2_get_buffer(v4l2_m2m_get_src_vq(m2m_ctx), inst->active_enc_src_idx);
+	if (!vb) {
+		dev_warn(inst->dev->dev, "%s: no active source buffer with index: %d\n",
+			 __func__, inst->active_enc_src_idx);
+		return NULL;
+	}
+
+	if (vb->state != VB2_BUF_STATE_ACTIVE) {
+		dev_warn(inst->dev->dev, "%s: source buffer (%d) was not active: %i\n",
+			 __func__, inst->active_enc_src_idx, vb->state);
+		return NULL;
+	}
+
+	return to_vb2_v4l2_buffer(vb);
+}
