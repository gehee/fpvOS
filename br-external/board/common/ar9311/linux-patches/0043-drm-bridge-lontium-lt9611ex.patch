From: fpvOS contributors
Subject: [PATCH] drm/bridge: add the Lontium LT9611EX DSI to HDMI bridge

The LT9611EX runs its own firmware: it follows the DSI input, sets up the
HDMI output and reads the sink's EDID itself, so neither lontium-lt9611 nor
lontium-lt9611uxc fits (I2C address 0x41, and a five-byte ASCII mailbox on
page 0xe0 instead of the UXC's registers). The host resets the chip, asks
for hot-plug state ("RH1:") and the cached EDID ("RH2:", "RH3:"), and turns
the output on and off ("WH1:E", "WH1:D"). Hot-plug is polled unless the
node has an interrupt.

Protocol from the BETAFPV P1 Nano VRX's stock firmware; the status commands
were checked on that unit, the video path was not.
---
--- a/drivers/gpu/drm/bridge/Kconfig
+++ b/drivers/gpu/drm/bridge/Kconfig
@@ -170,6 +170,16 @@
 	  HDMI signals
 	  Please say Y if you have such hardware.
 
+config DRM_LONTIUM_LT9611EX
+	tristate "Lontium LT9611EX DSI/HDMI bridge"
+	depends on OF
+	select DRM_KMS_HELPER
+	select DRM_MIPI_DSI
+	help
+	  Driver for the Lontium LT9611EX DSI to HDMI bridge, a
+	  variant that runs its own firmware and takes short
+	  commands from the host over I2C.
+
 config DRM_LONTIUM_LT9611UXC
 	tristate "Lontium LT9611UXC DSI/HDMI bridge"
 	select SND_SOC_HDMI_CODEC if SND_SOC
--- a/drivers/gpu/drm/bridge/Makefile
+++ b/drivers/gpu/drm/bridge/Makefile
@@ -15,6 +15,7 @@
 obj-$(CONFIG_DRM_LONTIUM_LT8912B) += lontium-lt8912b.o
 obj-$(CONFIG_DRM_LONTIUM_LT9211) += lontium-lt9211.o
 obj-$(CONFIG_DRM_LONTIUM_LT9611) += lontium-lt9611.o
+obj-$(CONFIG_DRM_LONTIUM_LT9611EX) += lontium-lt9611ex.o
 obj-$(CONFIG_DRM_LONTIUM_LT9611UXC) += lontium-lt9611uxc.o
 obj-$(CONFIG_DRM_LVDS_CODEC) += lvds-codec.o
 obj-$(CONFIG_DRM_MEGACHIPS_STDPXXXX_GE_B850V3_FW) += megachips-stdpxxxx-ge-b850v3-fw.o
--- a/drivers/gpu/drm/bridge/lontium-lt9611ex.c
+++ b/drivers/gpu/drm/bridge/lontium-lt9611ex.c
@@ -0,0 +1,432 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Lontium LT9611EX DSI to HDMI bridge.
+ *
+ * The chip runs its own firmware: it measures the DSI input, sets up the
+ * HDMI output and reads the sink's EDID by itself. The host talks to that
+ * firmware through a small mailbox on register page 0xe0: five command
+ * bytes in, an ASCII header and a payload out.
+ *
+ * Protocol from the BETAFPV P1 Nano VRX's stock firmware; the status
+ * commands were checked on that unit.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of_graph.h>
+
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_of.h>
+#include <drm/drm_print.h>
+#include <drm/drm_probe_helper.h>
+
+#define LT9611EX_PAGE		0xff
+#define LT9611EX_PAGE_CHIP	0x80
+#define LT9611EX_PAGE_MAILBOX	0xe0
+
+/* Page 0x80 */
+#define LT9611EX_I2C_ENABLE	0xee
+
+/* Page 0xe0 */
+#define LT9611EX_IRQ_FLAGS	0x84
+#define LT9611EX_IRQ_HPD	BIT(0)
+#define LT9611EX_RESPONSE	0x85	/* 4 header bytes, then the payload */
+#define LT9611EX_STATE		0xae	/* the firmware's echo of REQUEST */
+#define LT9611EX_COMMAND	0xb0	/* 5 bytes */
+#define LT9611EX_REQUEST	0xde	/* 1: take the mailbox, 2: run */
+#define LT9611EX_IRQ_CLEAR	0xdf
+
+#define LT9611EX_HEADER		4
+#define LT9611EX_EDID_CHUNK	32
+#define LT9611EX_HPD_CONNECTED	0x02
+
+struct lt9611ex {
+	struct device *dev;
+	struct drm_bridge bridge;
+	struct drm_bridge *next_bridge;
+	struct i2c_client *client;
+	struct device_node *dsi_node;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	/* One mailbox exchange, and the page selector, at a time. */
+	struct mutex lock;
+	bool enabled;
+	bool connected;
+};
+
+#define bridge_to_lt9611ex(x) container_of(x, struct lt9611ex, bridge)
+
+static int lt9611ex_write(struct lt9611ex *lt, u8 reg, u8 val)
+{
+	return i2c_smbus_write_byte_data(lt->client, reg, val);
+}
+
+static int lt9611ex_wait_state(struct lt9611ex *lt, u8 state)
+{
+	int ret, tries;
+
+	/* Stock gives the firmware about 100 ms and never fails; allow more. */
+	for (tries = 0; tries < 300; tries++) {
+		ret = i2c_smbus_read_byte_data(lt->client, LT9611EX_STATE);
+		if (ret < 0)
+			return ret;
+		if (ret == state)
+			return 0;
+		usleep_range(1000, 1500);
+	}
+	return -ETIMEDOUT;
+}
+
+/* Called with the lock held. @len payload bytes are copied to @payload. */
+static int lt9611ex_command_locked(struct lt9611ex *lt, const char *cmd, u8 arg,
+				   u8 *payload, unsigned int len)
+{
+	u8 header[LT9611EX_HEADER];
+	unsigned int i;
+	int ret;
+
+	ret = lt9611ex_write(lt, LT9611EX_PAGE, LT9611EX_PAGE_MAILBOX);
+	if (ret)
+		return ret;
+	ret = lt9611ex_write(lt, LT9611EX_REQUEST, 1);
+	if (ret)
+		return ret;
+	ret = lt9611ex_wait_state(lt, 1);
+	if (ret)
+		return ret;
+	for (i = 0; i < 4; i++) {
+		ret = lt9611ex_write(lt, LT9611EX_COMMAND + i, cmd[i]);
+		if (ret)
+			return ret;
+	}
+	ret = lt9611ex_write(lt, LT9611EX_COMMAND + 4, arg);
+	if (ret)
+		return ret;
+	ret = lt9611ex_write(lt, LT9611EX_REQUEST, 2);
+	if (ret)
+		return ret;
+	ret = lt9611ex_wait_state(lt, 2);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < LT9611EX_HEADER + len; i++) {
+		ret = i2c_smbus_read_byte_data(lt->client, LT9611EX_RESPONSE + i);
+		if (ret < 0)
+			return ret;
+		if (i < LT9611EX_HEADER)
+			header[i] = ret;
+		else
+			payload[i - LT9611EX_HEADER] = ret;
+	}
+	/* The answer to "RH1:" is headed "AH1:". */
+	if (header[0] != 'A' || memcmp(header + 1, cmd + 1, 3))
+		return -EPROTO;
+	return 0;
+}
+
+static int lt9611ex_command(struct lt9611ex *lt, const char *cmd, u8 arg,
+			    u8 *payload, unsigned int len)
+{
+	int ret;
+
+	mutex_lock(&lt->lock);
+	ret = lt9611ex_command_locked(lt, cmd, arg, payload, len);
+	mutex_unlock(&lt->lock);
+	if (ret)
+		dev_err_ratelimited(lt->dev, "command %.4s failed: %d\n", cmd, ret);
+	return ret;
+}
+
+static int lt9611ex_output(struct lt9611ex *lt, bool on)
+{
+	return lt9611ex_command(lt, "WH1:", on ? 'E' : 'D', NULL, 0);
+}
+
+/* Acknowledge a pending hot-plug event; returns whether there was one. */
+static bool lt9611ex_ack_hpd(struct lt9611ex *lt)
+{
+	bool event = false;
+	int ret;
+
+	mutex_lock(&lt->lock);
+	ret = lt9611ex_write(lt, LT9611EX_PAGE, LT9611EX_PAGE_MAILBOX);
+	if (!ret)
+		ret = i2c_smbus_read_byte_data(lt->client, LT9611EX_IRQ_FLAGS);
+	if (ret > 0 && (ret & LT9611EX_IRQ_HPD)) {
+		event = true;
+		lt9611ex_write(lt, LT9611EX_IRQ_CLEAR, 1);
+		usleep_range(10000, 11000);
+		lt9611ex_write(lt, LT9611EX_IRQ_CLEAR, 0);
+	}
+	mutex_unlock(&lt->lock);
+	return event;
+}
+
+static enum drm_connector_status
+lt9611ex_bridge_detect(struct drm_bridge *bridge, struct drm_connector *connector)
+{
+	struct lt9611ex *lt = bridge_to_lt9611ex(bridge);
+	bool connected;
+	u8 status;
+
+	lt9611ex_ack_hpd(lt);
+	if (lt9611ex_command(lt, "RH1:", 0, &status, 1))
+		return connector_status_unknown;
+	connected = status == LT9611EX_HPD_CONNECTED;
+
+	/*
+	 * Whether the firmware keeps its output on across a replug is not
+	 * known: ask again for a screen that appears while the bridge is on.
+	 */
+	if (connected && !lt->connected && lt->enabled)
+		lt9611ex_output(lt, true);
+	lt->connected = connected;
+
+	return connected ? connector_status_connected : connector_status_disconnected;
+}
+
+static int lt9611ex_get_edid_block(void *data, u8 *buf, unsigned int block, size_t len)
+{
+	struct lt9611ex *lt = data;
+	u8 chunk[1 + LT9611EX_EDID_CHUNK], size[2];
+	unsigned int first = block * EDID_LENGTH / LT9611EX_EDID_CHUNK;
+	unsigned int i, total;
+	int ret;
+
+	if (len != EDID_LENGTH)
+		return -EINVAL;
+
+	ret = lt9611ex_command(lt, "RH2:", 0, size, 2);
+	if (ret)
+		return ret;
+	total = size[0] << 8 | size[1];
+	if (total < (block + 1) * EDID_LENGTH)
+		return -ENODATA;
+
+	for (i = 0; i < EDID_LENGTH / LT9611EX_EDID_CHUNK; i++) {
+		/* The first payload byte is not EDID data. */
+		ret = lt9611ex_command(lt, "RH3:", first + i, chunk, sizeof(chunk));
+		if (ret)
+			return ret;
+		memcpy(buf + i * LT9611EX_EDID_CHUNK, chunk + 1, LT9611EX_EDID_CHUNK);
+	}
+	return 0;
+}
+
+static const struct drm_edid *
+lt9611ex_bridge_edid_read(struct drm_bridge *bridge, struct drm_connector *connector)
+{
+	struct lt9611ex *lt = bridge_to_lt9611ex(bridge);
+
+	return drm_edid_read_custom(connector, lt9611ex_get_edid_block, lt);
+}
+
+static void lt9611ex_bridge_atomic_enable(struct drm_bridge *bridge,
+					  struct drm_atomic_state *state)
+{
+	struct lt9611ex *lt = bridge_to_lt9611ex(bridge);
+
+	lt->enabled = true;
+	lt9611ex_output(lt, true);
+}
+
+static void lt9611ex_bridge_atomic_disable(struct drm_bridge *bridge,
+					   struct drm_atomic_state *state)
+{
+	struct lt9611ex *lt = bridge_to_lt9611ex(bridge);
+
+	lt->enabled = false;
+	lt9611ex_output(lt, false);
+}
+
+static int lt9611ex_bridge_attach(struct drm_bridge *bridge,
+				  struct drm_encoder *encoder,
+				  enum drm_bridge_attach_flags flags)
+{
+	struct lt9611ex *lt = bridge_to_lt9611ex(bridge);
+
+	return drm_bridge_attach(encoder, lt->next_bridge, bridge, flags);
+}
+
+static const struct drm_bridge_funcs lt9611ex_bridge_funcs = {
+	.attach = lt9611ex_bridge_attach,
+	.detect = lt9611ex_bridge_detect,
+	.edid_read = lt9611ex_bridge_edid_read,
+	.atomic_enable = lt9611ex_bridge_atomic_enable,
+	.atomic_disable = lt9611ex_bridge_atomic_disable,
+	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
+	.atomic_reset = drm_atomic_helper_bridge_reset,
+};
+
+static irqreturn_t lt9611ex_irq_thread(int irq, void *data)
+{
+	struct lt9611ex *lt = data;
+	u8 status;
+
+	if (!lt9611ex_ack_hpd(lt))
+		return IRQ_HANDLED;
+	if (!lt9611ex_command(lt, "RH1:", 0, &status, 1))
+		drm_bridge_hpd_notify(&lt->bridge, status == LT9611EX_HPD_CONNECTED ?
+				      connector_status_connected :
+				      connector_status_disconnected);
+	return IRQ_HANDLED;
+}
+
+static void lt9611ex_reset(struct lt9611ex *lt)
+{
+	if (!lt->reset_gpio)
+		return;
+	/* Stock's pulse: released 20 ms, held 20 ms, released 20 ms. */
+	gpiod_set_value_cansleep(lt->reset_gpio, 0);
+	msleep(20);
+	gpiod_set_value_cansleep(lt->reset_gpio, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(lt->reset_gpio, 0);
+	msleep(20);
+}
+
+static int lt9611ex_start(struct lt9611ex *lt)
+{
+	int ret;
+
+	lt9611ex_reset(lt);
+	mutex_lock(&lt->lock);
+	ret = lt9611ex_write(lt, LT9611EX_PAGE, LT9611EX_PAGE_CHIP);
+	if (!ret)
+		ret = lt9611ex_write(lt, LT9611EX_I2C_ENABLE, 1);
+	mutex_unlock(&lt->lock);
+	if (ret)
+		return ret;
+	/* The firmware answers the mailbox after this long on stock. */
+	msleep(200);
+	lt9611ex_ack_hpd(lt);
+	return 0;
+}
+
+static int lt9611ex_attach_dsi(struct lt9611ex *lt)
+{
+	const struct mipi_dsi_device_info info = { "lt9611ex", 0, NULL };
+	struct mipi_dsi_host *host;
+	struct device *dev = lt->dev;
+
+	host = of_find_mipi_dsi_host_by_node(lt->dsi_node);
+	if (!host)
+		return dev_err_probe(dev, -EPROBE_DEFER, "failed to find dsi host\n");
+
+	lt->dsi = devm_mipi_dsi_device_register_full(dev, host, &info);
+	if (IS_ERR(lt->dsi))
+		return dev_err_probe(dev, PTR_ERR(lt->dsi), "failed to create dsi device\n");
+
+	lt->dsi->lanes = 4;
+	lt->dsi->format = MIPI_DSI_FMT_RGB888;
+	lt->dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_HSE;
+
+	return devm_mipi_dsi_attach(dev, lt->dsi);
+}
+
+static int lt9611ex_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct lt9611ex *lt;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA))
+		return -ENODEV;
+
+	lt = devm_drm_bridge_alloc(dev, struct lt9611ex, bridge, &lt9611ex_bridge_funcs);
+	if (IS_ERR(lt))
+		return PTR_ERR(lt);
+
+	lt->dev = dev;
+	lt->client = client;
+	mutex_init(&lt->lock);
+	i2c_set_clientdata(client, lt);
+
+	lt->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(lt->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(lt->reset_gpio), "failed to get reset gpio\n");
+
+	lt->dsi_node = of_graph_get_remote_node(dev->of_node, 0, -1);
+	if (!lt->dsi_node)
+		return dev_err_probe(dev, -ENODEV, "failed to get remote node for the DSI input\n");
+
+	ret = drm_of_find_panel_or_bridge(dev->of_node, 2, -1, NULL, &lt->next_bridge);
+	if (ret)
+		goto err_of_put;
+
+	ret = lt9611ex_start(lt);
+	if (ret) {
+		dev_err_probe(dev, ret, "the bridge does not answer\n");
+		goto err_of_put;
+	}
+
+	lt->bridge.of_node = dev->of_node;
+	lt->bridge.ops = DRM_BRIDGE_OP_DETECT | DRM_BRIDGE_OP_EDID;
+	lt->bridge.type = DRM_MODE_CONNECTOR_HDMIA;
+
+	if (client->irq > 0) {
+		ret = devm_request_threaded_irq(dev, client->irq, NULL, lt9611ex_irq_thread,
+						IRQF_ONESHOT, "lt9611ex", lt);
+		if (ret) {
+			dev_err_probe(dev, ret, "failed to request irq\n");
+			goto err_of_put;
+		}
+		lt->bridge.ops |= DRM_BRIDGE_OP_HPD;
+	}
+
+	drm_bridge_add(&lt->bridge);
+
+	ret = lt9611ex_attach_dsi(lt);
+	if (ret)
+		goto err_remove_bridge;
+
+	return 0;
+
+err_remove_bridge:
+	drm_bridge_remove(&lt->bridge);
+err_of_put:
+	of_node_put(lt->dsi_node);
+	return ret;
+}
+
+static void lt9611ex_remove(struct i2c_client *client)
+{
+	struct lt9611ex *lt = i2c_get_clientdata(client);
+
+	drm_bridge_remove(&lt->bridge);
+	of_node_put(lt->dsi_node);
+}
+
+static const struct i2c_device_id lt9611ex_id[] = {
+	{ "lt9611ex" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(i2c, lt9611ex_id);
+
+static const struct of_device_id lt9611ex_match_table[] = {
+	{ .compatible = "lontium,lt9611ex" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, lt9611ex_match_table);
+
+static struct i2c_driver lt9611ex_driver = {
+	.driver = {
+		.name = "lt9611ex",
+		.of_match_table = lt9611ex_match_table,
+	},
+	.probe = lt9611ex_probe,
+	.remove = lt9611ex_remove,
+	.id_table = lt9611ex_id,
+};
+module_i2c_driver(lt9611ex_driver);
+
+MODULE_DESCRIPTION("Lontium LT9611EX DSI to HDMI bridge");
+MODULE_LICENSE("GPL");
