+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/qiyang,qy45043a0.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: Qiyang QY45043A0 MIPI DSI panel
+maintainers:
+  - mh1412 <mh1412@users.noreply.github.com>
+allOf:
+  - $ref: panel-common.yaml#
+properties:
+  compatible:
+    const: qiyang,qy45043a0
+  reg:
+    maxItems: 1
+  reset-gpios:
+    maxItems: 1
+    description: Active-high panel reset release.
+  enable-gpios:
+    maxItems: 1
+    description: Active-high secondary panel supply enable.
+  backlight: true
+  port: true
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - enable-gpios
+  - port
+unevaluatedProperties: false
