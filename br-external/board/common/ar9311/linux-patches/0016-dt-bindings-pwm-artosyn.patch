From: fpvOS contributors <dev@fpvos.local>
Subject: [PATCH] dt-bindings: pwm: describe Artosyn AR9301 controller

Document the eight-channel normal-polarity PWM provider and its clock.

Upstream: not submitted
Signed-off-by: fpvOS contributors <dev@fpvos.local>

--- /dev/null
+++ b/Documentation/devicetree/bindings/pwm/artosyn,ar9301-pwm.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pwm/artosyn,ar9301-pwm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Artosyn AR9301/AR9311 PWM controller
+
+maintainers:
+  - fpvOS contributors <dev@fpvos.local>
+
+description: |
+  Eight channels with separate high and low cycle counters. Only normal
+  polarity is supported. The input clock on AR9311 is the 150 MHz host
+  reference. Pinmux and peripheral gates are inherited from boot firmware.
+
+allOf:
+  - $ref: pwm.yaml#
+
+properties:
+  compatible:
+    const: artosyn,ar9301-pwm
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  '#pwm-cells':
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - '#pwm-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    pwm@1000000 {
+        compatible = "artosyn,ar9301-pwm";
+        reg = <0x01000000 0x2000>;
+        clocks = <&host_ref>;
+        #pwm-cells = <2>;
+    };
