#!/bin/sh
# CDC-ECM development link plus vendor-framed CDC-ACM updates. All state lives in the RAM filesystem/configfs.
set -eu

. /etc/default/ar9311-usb
: "${USB_SERIAL:?}" "${USB_PRODUCT:?}" "${USB_ADDRESS:?}"
: "${USB_DEVICE_MAC:?}" "${USB_HOST_MAC:?}"

g=/sys/kernel/config/usb_gadget/fpvos

start() {
	modprobe dwc2
	modprobe libcomposite
	modprobe usb_f_ecm
	modprobe usb_f_acm
	mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
	if [ ! -d "$g" ]; then
		mkdir "$g"
		echo 0x1d6b > "$g/idVendor"
		echo 0x0104 > "$g/idProduct"
		mkdir "$g/strings/0x409"
		echo "$USB_SERIAL" > "$g/strings/0x409/serialnumber"
		echo fpvOS > "$g/strings/0x409/manufacturer"
		echo "$USB_PRODUCT" > "$g/strings/0x409/product"
		mkdir "$g/configs/c.1"
		mkdir "$g/configs/c.1/strings/0x409"
		echo 'USB Ethernet + firmware transfer' > "$g/configs/c.1/strings/0x409/configuration"
		echo 0xc0 > "$g/configs/c.1/bmAttributes"
		echo 2 > "$g/configs/c.1/MaxPower"
		mkdir "$g/functions/ecm.usb0"
		echo "$USB_DEVICE_MAC" > "$g/functions/ecm.usb0/dev_addr"
		echo "$USB_HOST_MAC" > "$g/functions/ecm.usb0/host_addr"
		ln -s "$g/functions/ecm.usb0" "$g/configs/c.1/ecm.usb0"
		mkdir "$g/functions/acm.usb0"
		ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0"
	fi
	if [ -z "$(cat "$g/UDC")" ]; then
		# Both AR9311 boards use this native USB controller.
		test -d /sys/class/udc/8000000.usb
		echo 8000000.usb > "$g/UDC"
	fi
	# ECM registers its netdev when the gadget is bound to the controller.
	ip address replace "$USB_ADDRESS" dev usb0
	ip link set usb0 up
	echo "USB Ethernet ready: $USB_ADDRESS"
}

stop() {
	[ -d "$g" ] || return 0
	printf '\n' > "$g/UDC"
	ip link set usb0 down
	rm "$g/configs/c.1/ecm.usb0" "$g/configs/c.1/acm.usb0"
	rmdir "$g/functions/acm.usb0" "$g/functions/ecm.usb0" "$g/configs/c.1/strings/0x409" \
		"$g/configs/c.1" "$g/strings/0x409" "$g"
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
