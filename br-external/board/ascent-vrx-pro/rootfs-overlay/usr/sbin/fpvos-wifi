#!/bin/sh
# fpvos-wifi - the goggle's WiFi access point.    start | stop | status
#
# The VRX Pro carries a Realtek RTL8188FU-family USB WiFi chip (0bda:f179),
# powered by GPIO 105 and off unless something turns it on. Its driver is the
# kernel's own rtl8xxxu, which has access-point mode for the RTL8188F from 6.12
# (the stock firmware's binary RTL8189FU.ko only loads into the stock kernel).
#
# kestrel's SYSTEM > WiFi AP menu item runs this whenever it is toggled, and
# the AP stays up for that session only: nothing starts it at boot (/run, where
# its state lives, is empty after every boot), so it is always off after a
# reboot. It is a 2.4 GHz transmitter sitting next to the RC link.
#
# Network: SSID fpvOS-XXXX (the chip's MAC), WPA2 with the passphrase 12345678 -
# the shortest WPA2 allows, and what stock uses. It keeps nobody out and is not
# meant to: this is an open platform on the pilot's own bench. Both live in
# /etc/fpvos/wifi-ap, written the first time the AP starts, and can be edited
# there. The goggle is 192.168.4.1 and hands out .100-.120.
#
# SSH is not reachable over this network, so the published root password is
# not a way in for anyone who joins the AP. dropbear listens on the USB link's
# address only (see /etc/default/dropbear), but that alone does not keep it off
# WiFi: Linux delivers a packet for any of the goggle's addresses on whichever
# interface it arrives, so a client routing 192.168.3.1 through 192.168.4.1
# would reach it. guard() drops that, and SSH from the AP altogether, before
# the AP comes up; the AP does not start without it.
#
# Channel: 1, 6 or 11, whichever is quietest in a scan taken just before the AP
# starts. hostapd's own automatic selection (channel=0) cannot work here - this
# driver reports no survey data - so the choice is made from the scan instead.

GPIO=105
MOD=rtl8xxxu
IDENT=/etc/fpvos/wifi-ap
RUN=/run/fpvos-wifi
ADDR=192.168.4.1

log() { echo "fpvos-wifi: $*"; }

# Our udhcpd, found by its config path: this busybox has no pidfile support,
# so the "pidfile" line in its config is ignored. (The other udhcpd, on the USB
# link, has its own config and is left alone.)
our_udhcpd() {
    for p in $(pidof udhcpd); do
        grep -q "$RUN/udhcpd.conf" /proc/$p/cmdline 2>/dev/null && echo $p
    done
}

running() { [ -f "$RUN/hostapd.pid" ] && kill -0 "$(cat "$RUN/hostapd.pid")" 2>/dev/null; }

# Nothing from the AP reaches the USB link (192.168.3.0/24, S30usbgadget) or
# SSH. Once in, the rules stay: wlan0 matches by name, so they hold whenever
# the AP is up again.
GUARD_RULES='-i wlan0 -d 192.168.3.0/24 -j DROP
-i wlan0 -p tcp --dport 22 -j DROP'
guard() {
    command -v iptables >/dev/null || return 1
    echo "$GUARD_RULES" | while read -r rule; do
        iptables -C INPUT $rule 2>/dev/null || iptables -I INPUT $rule || exit 1
    done
}

power() {
    [ -d /sys/class/gpio/gpio$GPIO ] || echo $GPIO > /sys/class/gpio/export
    echo out > /sys/class/gpio/gpio$GPIO/direction
    echo "$1" > /sys/class/gpio/gpio$GPIO/value
}

# A KEY= line of /etc/fpvos/wifi-ap, as text: everything after the first
# "KEY=" to the end of the line, as kestrel reads it for its menu and QR code.
# The file is never sourced as shell, so a name with spaces or a passphrase
# with $ or ` in it is taken as written, not run.
ident_key() { sed -n "s/^$1=//p" "$IDENT" 2>/dev/null | head -n 1; }

# What WPA2 and hostapd can use: an SSID of 1-32 bytes with no control
# characters, a passphrase of 8-63 printable ASCII characters.
ssid_ok() {
    n=$(printf '%s' "$1" | wc -c | tr -dc 0-9)
    c=$(printf '%s' "$1" | tr -d '\001-\037\177' | wc -c | tr -dc 0-9)
    [ "$n" -ge 1 ] && [ "$n" -le 32 ] && [ "$c" = "$n" ]
}
passphrase_ok() {
    n=$(printf '%s' "$1" | wc -c | tr -dc 0-9)
    [ "$n" -ge 8 ] && [ "$n" -le 63 ] && [ -z "$(printf '%s' "$1" | tr -d '\040-\176')" ]
}

# The network's name and passphrase into SSID and PASSPHRASE. The file is
# written the first time the AP starts and left alone after that, so an edit
# to it sticks - unless a value in it cannot be used (an empty or damaged file,
# a passphrase too short for WPA2): that one is replaced by the default and the
# file written afresh, rather than the AP never starting.
identity() {
    SSID=$(ident_key SSID); PASSPHRASE=$(ident_key PASSPHRASE)
    ssid_ok "$SSID" && passphrase_ok "$PASSPHRASE" && return 0
    if [ -e "$IDENT" ]; then
        ssid_ok "$SSID" || log "$IDENT: no usable SSID (1-32 bytes) - back to the default"
        passphrase_ok "$PASSPHRASE" || log "$IDENT: no usable PASSPHRASE (8-63 printable ASCII) - back to the default"
    fi
    if ! ssid_ok "$SSID"; then
        mac=$(tr -d ':' < /sys/class/net/wlan0/address | tr 'a-f' 'A-F')
        SSID=fpvOS-$(echo "$mac" | cut -c9-12)
    fi
    passphrase_ok "$PASSPHRASE" || PASSPHRASE=12345678
    mkdir -p "$(dirname "$IDENT")"
    printf 'SSID=%s\nPASSPHRASE=%s\n' "$SSID" "$PASSPHRASE" > "$IDENT.new"
    chmod 600 "$IDENT.new" && mv "$IDENT.new" "$IDENT" && sync
}

# Score 1, 6 and 11 by what the scan heard: each network adds its strength
# (dBm above -100), scaled by how much its channel overlaps the candidate.
# Lowest score wins; with nothing heard at all, 6.
pick_channel() {
    iw dev wlan0 scan 2>/dev/null | awk '
        /^BSS / { if (f) seen(); f = 0; s = -100 }
        /freq:/ { f = $2 }
        /signal:/ { s = $2 }
        function seen(  ch, c, d) {
            if (f < 2412 || f > 2484) return
            ch = (f == 2484) ? 14 : (f - 2407) / 5
            for (c = 1; c <= 11; c += 5) {
                d = ch - c; if (d < 0) d = -d
                if (d < 5) score[c] += (s + 100) * (5 - d) / 5
            }
            n++
        }
        END {
            if (f) seen()
            if (!n) { print 6; exit }
            best = 1
            for (c = 6; c <= 11; c += 5) if (score[c] < score[best]) best = c
            print best
        }'
}

start() {
    if running; then log "already running"; return 0; fi
    command -v hostapd >/dev/null || { log "hostapd missing from this image"; return 1; }
    mkdir -p "$RUN"

    power 1
    grep -q "^$MOD " /proc/modules || modprobe $MOD || { log "modprobe $MOD failed"; power 0; return 1; }
    i=0
    while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 50 ]; do usleep 100000; i=$((i + 1)); done
    [ -e /sys/class/net/wlan0 ] || { log "wlan0 never appeared"; stop; return 1; }

    guard || { log "cannot keep the AP off SSH and the USB link (iptables); not starting it"; stop; return 1; }
    identity
    ifconfig wlan0 up
    ch=$(pick_channel)
    [ -n "$ch" ] || ch=6

    # For phones, which doze between frames many times a second (an iPhone
    # 10-20 times while streaming): broadcast and multicast go to each
    # station as unicast, which the AP holds for a dozing one and announces
    # in its TIM (sent as broadcast at any time, a dozing phone missed DHCP
    # offers and ARP: 169.254.x, no web page); beacons every 50 ms with a
    # DTIM in each, so a dozing phone hears about its frames sooner; short
    # guard interval (rtl8xxxu receives it at 20 MHz).
    cat > "$RUN/hostapd.conf" <<EOF
interface=wlan0
driver=nl80211
ctrl_interface=$RUN/ctl
ssid=$SSID
hw_mode=g
channel=$ch
ieee80211n=1
ht_capab=[SHORT-GI-20]
wmm_enabled=1
beacon_int=50
dtim_period=1
multicast_to_unicast=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=$PASSPHRASE
max_num_sta=4
EOF
    chmod 600 "$RUN/hostapd.conf"
    ifconfig wlan0 $ADDR netmask 255.255.255.0 up
    hostapd -B -P "$RUN/hostapd.pid" -f /var/log/hostapd.log "$RUN/hostapd.conf" ||
        { log "hostapd failed, see /var/log/hostapd.log"; stop; return 1; }

    cat > "$RUN/udhcpd.conf" <<EOF
interface wlan0
start 192.168.4.100
end 192.168.4.120
max_leases 21
lease_file $RUN/udhcpd.leases
option subnet 255.255.255.0
option lease 3600
EOF
    touch "$RUN/udhcpd.leases"
    for p in $(our_udhcpd); do kill $p; done
    udhcpd "$RUN/udhcpd.conf" || log "udhcpd failed - clients will need a static address"

    echo "channel $ch" > "$RUN/state"
    log "on: $SSID, channel $ch, $ADDR"
}

stop() {
    # hostapd takes a moment to tear the AP down; unload the driver only once
    # it has gone (up to 2 s), not out from under it.
    if [ -f "$RUN/hostapd.pid" ]; then
        hp=$(cat "$RUN/hostapd.pid")
        kill "$hp" 2>/dev/null
        i=0
        while kill -0 "$hp" 2>/dev/null && [ $i -lt 20 ]; do usleep 100000; i=$((i + 1)); done
        kill -9 "$hp" 2>/dev/null
        rm -f "$RUN/hostapd.pid"
    fi
    for p in $(our_udhcpd); do kill $p; done
    i=0
    while [ -n "$(our_udhcpd)" ] && [ $i -lt 10 ]; do usleep 100000; i=$((i + 1)); done
    [ -e /sys/class/net/wlan0 ] && ifconfig wlan0 down
    grep -q "^$MOD " /proc/modules && rmmod $MOD
    power 0
    rm -f "$RUN/state"
    log "off"
}

status() {
    if running; then
        echo "on $(ident_key SSID) $(cat "$RUN/state" 2>/dev/null)"
    else
        echo "off"
    fi
}

case "$1" in
    start)  start ;;
    stop)   stop ;;
    status) status ;;
    *) echo "usage: $0 {start|stop|status}" >&2; exit 1 ;;
esac
