// SPDX-License-Identifier: GPL-2.0-or-later
/* BETAFPV VR04 HD Pro goggles (stock board "haming_gnd_pro", hardware V2.1):
 * the P1 goggles' wiring with another display. Stock reaches the panel
 * through a GM8773C bridge it programs over I2C (0x57; bus 3 by the stock
 * display library's attributes) and raises GPIO105 for this board alone.
 * The USB-C DisplayPort output (an LT9711 on I2C0) is not driven.
 * From the stock 2.1.4 firmware alone: not run on a unit.
 */
/dts-v1/;
#include "ar9311.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "BETAFPV P1 goggles Pro (AR9311)";
	compatible = "betafpv,p1-goggle-pro", "artosyn,proxima-9311";

	reboot-scratch@a106138 {
		compatible = "syscon", "simple-mfd";
		reg = <0 0x0a106138 0 4>;
		reboot-mode {
			compatible = "syscon-reboot-mode";
			offset = <0>;
			mode-normal = <2>;
			mode-bootloader = <3>;
		};
	};
	p1-goggle-keys {
		compatible = "adc-keys";
		io-channels = <&adc 0>;
		io-channel-names = "buttons";
		poll-interval = <10>;
		keyup-threshold-microvolt = <0>;
		button-bind { label = "bind"; linux,code = <KEY_CONNECT>; press-threshold-microvolt = <200000>; };
		button-back { label = "back"; linux,code = <KEY_BACK>; press-threshold-microvolt = <400000>; };
		button-record { label = "record"; linux,code = <KEY_RECORD>; press-threshold-microvolt = <600000>; };
		button-up { label = "up"; linux,code = <KEY_UP>; press-threshold-microvolt = <800000>; };
		button-left { label = "left"; linux,code = <KEY_LEFT>; press-threshold-microvolt = <1000000>; };
		button-right { label = "right"; linux,code = <KEY_RIGHT>; press-threshold-microvolt = <1200000>; };
		button-enter { label = "enter"; linux,code = <KEY_ENTER>; press-threshold-microvolt = <1400000>; };
		button-down { label = "down"; linux,code = <KEY_DOWN>; press-threshold-microvolt = <1600000>; };
	};

	aliases { serial0 = &uart0; };
	chosen {
		stdout-path = "serial0:1152000n8";
		bootargs = "console=ttyS0,1152000 earlycon loglevel=7 mem=148M rdinit=/init";
	};

	/* Stock has 256 MiB DRAM: 148 MiB Linux and 108 MiB media. */
	memory@20000000 {
		device_type = "memory";
		reg = <0 0x20000000 0 0x10000000>;
	};
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		codec_memory: media@29400000 {
			compatible = "shared-dma-pool";
			reg = <0 0x29400000 0 0x06b00000>;
			no-map;
		};
		loader@2ff00000 {
			reg = <0 0x2ff00000 0 0x00100000>;
			no-map;
		};
	};
};

/* The stock SPL uses the same secondary CPU handshake as P1 Air.
 * A diagnostic Linux-to-Linux loader may instead park CPU1 and use maxcpus=1.
 */
&cpu0 { enable-method = "ar-spin-table"; };
&cpu1 {
	enable-method = "ar-spin-table";
	cpu-release-addr = <0 0x00100000>;
};
&uart0 { status = "okay"; };
&usb {
	status = "okay";
	dr_mode = "peripheral";
};
&watchdog { status = "okay"; };

/* The battery-backed clock, a DS1307 at 0x68 on I2C0 as every stock P1
 * ground tree has it: the kernel sets the system clock from it at boot, and
 * the updater's SET_TIME writes it (in UTC). The Pro's LT9711 (DisplayPort out)
 * sits on this bus too and is left alone.
 */
&i2c0 {
	status = "okay";
	clock-frequency = <400000>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <300>;
	i2c-scl-falling-time-ns = <300>;

	rtc@68 {
		compatible = "dallas,ds1307";
		reg = <0x68>;
	};
};

&gpio {
	status = "okay";
	/* GPIO100 is the shared panel/SD I/O rail. Do not cycle it when
	 * probing or removing the SD card. Stock keeps it at 3.3 V.
	 */
	sd-panel-power-hog {
		gpio-hog;
		gpios = <100 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sd-panel-power";
	};
};
&mmc_clocks {
	status = "okay";
	artosyn,clock-config = <0x87 2>, <0x80 0>;
};
&mmc1 {
	status = "okay";
	clock-frequency = <100000000>;
	max-frequency = <50000000>;
	card-detect-delay = <200>;
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-1-8-v;
	no-mmc;
	no-sdio;
};

&qspi_clock { status = "okay"; };
&qspi {
	status = "okay";
	clocks = <&qspi_clock>;
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <25000000>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			partition@0 { label = "stock-spl"; reg = <0 0x100000>; read-only; };
			partition@100000 { label = "boot-state"; reg = <0x100000 0x80000>; };
			partition@180000 { label = "stock-vendor"; reg = <0x180000 0x80000>; read-only; };
			partition@200000 { label = "factory"; reg = <0x200000 0x600000>; read-only; };
			partition@800000 { label = "stock-bootloaders"; reg = <0x800000 0x240000>; read-only; };
			/* Both banks, under the stock names: an install picks the bank
			 * (fpvos-update: the one holding fpvOS, else the one not booted)
			 * and its checks, not the DT, keep the stock bank unwritten. */
			partition@a40000 { label = "kernel0"; reg = <0xa40000 0x600000>; };
			partition@1040000 { label = "kernel1"; reg = <0x1040000 0x600000>; };
			partition@1640000 { label = "dtb0"; reg = <0x1640000 0x60000>; };
			partition@16a0000 { label = "dtb1"; reg = <0x16a0000 0x60000>; };
			partition@1700000 { label = "userapp0"; reg = <0x1700000 0x2d00000>; };
			partition@4400000 { label = "userapp1"; reg = <0x4400000 0x2d00000>; };
			partition@7100000 { label = "usr_data"; reg = <0x7100000 0x600000>; };
		};
	};
};

/* Stock drives GPIO42 and GPIO107 low on every ground unit (the P1 goggles'
 * scan straps), and GPIO105 high on this board only: taken as the display
 * chain's enable.
 */
&gpio {
	panel-scan-horizontal {
		gpio-hog;
		gpios = <42 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "panel-scan-horizontal";
	};
	panel-scan-vertical {
		gpio-hog;
		gpios = <107 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "panel-scan-vertical";
	};
	pro-display-enable {
		gpio-hog;
		gpios = <105 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "pro-display-enable";
	};
};

&vo {
	status = "okay";
	artosyn,display-profile = "p1-goggle-pro-1080p";
	port {
		vo_out: endpoint { remote-endpoint = <&dsi_in>; };
	};
};
&dsi {
	status = "okay";
	artosyn,display-profile = "p1-goggle-pro-1080p";
	#address-cells = <1>;
	#size-cells = <0>;
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			dsi_in: endpoint { remote-endpoint = <&vo_out>; };
		};
		port@1 {
			reg = <1>;
			dsi_out: endpoint { remote-endpoint = <&panel_in>; };
		};
	};
};

/* The bridge and the panel behind it: no reset line, no backlight and no
 * brightness control in stock's library.
 */
&i2c3 {
	status = "okay";
	clock-frequency = <400000>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <300>;
	i2c-scl-falling-time-ns = <300>;

	display@57 {
		compatible = "betafpv,vr04-pro-display";
		reg = <0x57>;
		port {
			panel_in: endpoint { remote-endpoint = <&dsi_out>; };
		};
	};
};

&vpu {
	status = "okay";
	memory-region = <&codec_memory>;
	firmware-name = "artosyn/p1-goggle-chagall.bin";
};

&adc { status = "okay"; };

/* Stock start_ar813x.sh resets the radio on GPIO23. */
/ {
	p1_radio_pwrseq: radio-pwrseq {
		compatible = "artosyn,ar8030-pwrseq";
		reset-gpios = <&gpio 23 GPIO_ACTIVE_LOW>;
	};
};
&mmc0 {
	status = "okay";
	clock-frequency = <100000000>;
	max-frequency = <50000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	broken-cd;
	no-mmc;
	no-sd;
	no-1-8-v;
	mmc-pwrseq = <&p1_radio_pwrseq>;
};

&watchdog { status = "okay"; };
