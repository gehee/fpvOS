# Gnd485 NAND, fixed HDMI pipeline, DMA pool and USB device role.
CONFIG_MTD=y
CONFIG_MTD_SPI_NAND=y
# CONFIG_MTD_PARTITIONED_MASTER is not set
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_DRM=y
CONFIG_DRM_ARTOSYN=y
CONFIG_DRM_LONTIUM_LT9611=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
# CONFIG_DRM_FBDEV_EMULATION is not set
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=32
# Front-panel external ADC and userspace-owned beeper. LINK uses the
# existing GPIO character interface (bank A offset 2, active-low).
CONFIG_I2C_CHARDEV=y
CONFIG_PWM=y
CONFIG_PWM_ARTOSYN=y
# Read-only compressed application/assets, shipped inside the initramfs.
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# Shared display/compositor clock register serialization.
CONFIG_MFD_SYSCON=y
