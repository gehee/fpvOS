config BR2_FPVOS_SOC_AR9311
	bool "Artosyn AR9311 SoC"
	depends on BR2_aarch64
	help
	  Enable packages for the AR9311 host controllers. Boards
	  still supply their wiring, firmware profiles and storage
	  policy.

config BR2_FPVOS_BOARD_ASCENT_VRX
	bool "Caddx Ascent VRX (Gnd485, AR9311)"
	depends on BR2_aarch64
	select BR2_FPVOS_SOC_AR9311
	help
	  Select Gnd485 board integration, including its NAND
	  partition parser. Other AR9311 boards can reuse
	  board/common/ar9311 without selecting this board's wiring,
	  stock firmware layout or update backend.

config BR2_FPVOS_BOARD_P1_AIR
	bool "BETAFPV P1 Air (AR9311)"
	depends on BR2_aarch64
	select BR2_FPVOS_SOC_AR9311
	help
	  P1 board storage and direct NAND recovery policy. Uses the
	  verified P1 partition layout; installs on the bank not holding
	  stock (either bank) and preserves the stock bank.

config BR2_FPVOS_BOARD_P1_GOGGLE
	bool "BETAFPV P1 goggles (AR9311)"
	depends on BR2_aarch64
	select BR2_FPVOS_SOC_AR9311
	help
	  P1 goggles. Reuses shared AR9311 drivers with board-specific
	  memory and SD wiring. The defconfig selects the native Kestrel
	  receiver and the NAND updater, which installs on the bank not
	  holding stock (either bank) and preserves the stock bank.

config BR2_FPVOS_BOARD_P1_GND
	bool "BETAFPV P1 ground units: goggles, VRX, Nano VRX (AR9311)"
	depends on BR2_aarch64
	select BR2_FPVOS_SOC_AR9311
	help
	  One image for every BETAFPV P1 ground unit, as stock's common
	  P1_GND firmware (2.1.4) is: one kernel and root filesystem, a
	  device tree per unit (the goggles' panel, the Nano VRX's HDMI
	  bridge), and at boot the unit's own Open8030 radio image and
	  configuration, chosen from its device tree. The P1 A/B flash
	  layout; the updater installs on the bank not holding stock.

config BR2_FPVOS_BOARD_SKYZONE_STEADYDIGITAL
	bool "Skyzone SteadyDigital (AR9311)"
	depends on BR2_aarch64
	select BR2_FPVOS_SOC_AR9311
	help
	  SteadyDigital receiver wiring: SDIO radio, LT9611 HDMI
	  bridge, polled GPIO keys. Uses the stock A/B flash layout;
	  the flash image's updater installs on the bank not holding
	  stock (either bank) and never writes the stock bank or
	  factory data.
