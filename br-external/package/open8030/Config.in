config BR2_PACKAGE_OPEN8030
	bool "open8030"
	depends on BR2_HOSTARCH = "x86_64" # prebuilt RISC-V compiler
	select BR2_PACKAGE_OPEN8030_PROFILES
	help
	  Open8030, the open-source firmware for the AR8030 radio
	  chip, built from source with Zephyr and installed next to
	  stock's. The goggle loads it unless kestrel-gnd's RADIO >
	  Radio Firmware says STOCK (ar8030_firmware: 0); the air unit
	  (a Lite or Lite+) when /usrdata/fpv/air/open8030/always
	  exists.

	  The board selects its profile, host transport and radio
	  role. Profiles come from open8030-profiles or an explicit
	  private path.

if BR2_PACKAGE_OPEN8030

config BR2_PACKAGE_OPEN8030_PROFILE_P1_STOCK
	bool "Extract P1 Air profile from stock firmware"
	depends on BR2_aarch64
	select BR2_PACKAGE_P1_AIR_VENDOR
	help
	  Generate the P1 board data from the pinned vendor radio image.
	  Overrides the profile filename below; private-directory overrides
	  still apply for development.

config BR2_PACKAGE_OPEN8030_PROFILE
	string "Board profile source"
	depends on !BR2_PACKAGE_OPEN8030_PROFILE_P1_STOCK
	help
	  Profile filename from open8030-profiles, or an absolute path
	  to a private profile. Set this in the board defconfig. A
	  make-time OPEN8030_PRIVATE_DIR override looks up this
	  profile's basename in that directory instead.

choice
	prompt "Host transport"
	default BR2_PACKAGE_OPEN8030_TRANSPORT_SDIO

config BR2_PACKAGE_OPEN8030_TRANSPORT_SDIO
	bool "SDIO"
	help
	  Keep the firmware's existing active-bus detection. The SDIO
	  host must enumerate the radio before firmware starts.

config BR2_PACKAGE_OPEN8030_TRANSPORT_USB
	bool "USB"
	help
	  Force the firmware's USB transport with AR_FORCE_USB.

endchoice

config BR2_PACKAGE_OPEN8030_ROLE_AP
	bool "Air / access-point role"
	help
	  Build with AR_ROLE_AP. Otherwise build the ground/station
	  role. Air firmware is installed under
	  /usrdata/fpv/air/open8030; ground firmware and its
	  configuration go under /lib/firmware.

config BR2_PACKAGE_OPEN8030_FACTORY_OPTIONAL
	bool "Allow operation without factory data"
	help
	  Build with AR_FACTORY_OPTIONAL. Select only for boards whose
	  profile has been validated without mandatory factory data.

config BR2_PACKAGE_OPEN8030_PINS_BEFORE_FACTORY
	bool "Initialize pins before reading factory storage"
	help
	  Set up the board's pin mux before attempting factory-data access.

config BR2_PACKAGE_OPEN8030_EXPLICIT_IO_DOMAINS
	bool "Apply the profile's explicit I/O voltage domains"
	help
	  Replace the two I/O-domain select bits with the profile value,
	  rather than preserving bootloader-selected bits.

config BR2_PACKAGE_OPEN8030_SDIO_BLOCK_TRAILER
	bool "Stock P1 SDIO block-tail framing"
	depends on BR2_PACKAGE_OPEN8030_TRANSPORT_SDIO
	help
	  Use the DD block trailer expected by P1's stock Linux 4.9
	  artosyn_sdio command transport. This is not the ar_libre wire
	  format; do not enable it with an arlink host driver.

config BR2_PACKAGE_OPEN8030_CONFIG
	string "Ground radio configuration"
	default "bb_config_gnd_open8030.json"
	depends on !BR2_PACKAGE_OPEN8030_ROLE_AP
	help
	  Configuration filename from open8030-profiles, or an
	  absolute path. Installed as open8030.json independently of
	  the input name. OPEN8030_CONFIG_DIR (by default
	  OPEN8030_PRIVATE_DIR) can override the source directory at
	  make time. Air units use their runtime board-specific stock
	  configuration.

config BR2_PACKAGE_OPEN8030_AIR_DEFAULT
	bool "air unit boots on Open8030"
	depends on BR2_PACKAGE_KESTREL_AIR
	depends on BR2_PACKAGE_OPEN8030_ROLE_AP
	help
	  Ship /usrdata/fpv/air/open8030/always, so that a Lite or
	  Lite+ starts its radio on Open8030 from the first boot. The
	  goggle has to run Open8030 too (its default). Remove the
	  file on the unit to go back to stock's firmware.

endif
