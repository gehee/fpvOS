From: fpvOS developers
Subject: [PATCH] Add opt-in stock P1 SDIO framing and explicit I/O domains

Keep the default transport unchanged. P1 stock artosyn_sdio adds a
00 DD length_le16 trailer at the end of each aligned block. Reject
malformed trailers (and CC blocks, the stock driver's network device,
which Open8030 does not carry) before a block counts as received, and
test the boundary between single and multiple blocks.

Upstream: not submitted

diff --git a/src/rf_device.c b/src/rf_device.c
index b4baa72..9a1473a 100644
--- a/src/rf_device.c
+++ b/src/rf_device.c
@@ -1243,7 +1243,11 @@ int ar_rf_setup_pins(const uint8_t *records, size_t length)
 	update(CLOCK + 0x200, 0, 1u << 25); /* Measured GPIO clock ID 21. */
 	/* Stock 0x24be84(bank, 0) after muxing banks 2 and 3: GPIO+0 bits 1
 	 * and 2 (their I/O domain select). */
+	#ifdef AR_EXPLICIT_IO_DOMAINS
+	if (io_domains) { update(0x0a10a000, 6, io_domains); }
+#else
 	if (io_domains) { update(0x0a10a000, 0, io_domains); }
+#endif
 	else {
 		if (seen[2]) { update(0x0a10a000, 0, 2); }
 		if (seen[3]) { update(0x0a10a000, 0, 4); }
diff --git a/src/sdio_device.c b/src/sdio_device.c
index 68f36b8..ebe1026 100644
--- a/src/sdio_device.c
+++ b/src/sdio_device.c
@@ -219,6 +219,24 @@ void ar_sdio_init(void)
 #endif
 }
 
+/* Invalidates the received block and returns its payload length, 0 when the
+ * block is malformed. */
+static size_t received_payload(size_t length)
+{
+	ar_cache_invalidate(receive_buffer, AR_SDIO_BUFFER_SIZE);
+#ifdef AR_SDIO_P1_TRAILER
+	/* P1 stock artosyn_sdio ends each aligned transfer with 00 DD length_le16.
+	 * DD carries native command frames. CC carries the stock driver's network
+	 * device (IP frames): Open8030 has no host network path, so a CC block is
+	 * dropped and counted in invalid_rx like any other malformed one. */
+	if (length < 4 || receive_buffer[length - 4] || receive_buffer[length - 3] != 0xdd) { return 0; }
+	size_t payload = receive_buffer[length - 2] | (size_t)receive_buffer[length - 1] << 8;
+	return payload <= length - 4 ? payload : 0;
+#else
+	return length;
+#endif
+}
+
 size_t ar_sdio_receive(const uint8_t **data)
 {
 	/* The caller has finished the previous descriptor before polling again.
@@ -275,8 +293,8 @@ size_t ar_sdio_receive(const uint8_t **data)
 		barrier();
 		size_t length = read32(SDIO_BASE + RX_LENGTH) & 0xffff;
 		if (!(events & (8 | 16)) && length && length <= sizeof receive_buffer &&
-		    read32(SDIO_BASE + RX_ADDR) == pointer(receive_buffer)) {
-			ar_cache_invalidate(receive_buffer, AR_SDIO_BUFFER_SIZE);
+		    read32(SDIO_BASE + RX_ADDR) == pointer(receive_buffer) &&
+		    (length = received_payload(length))) {
 			*data = receive_buffer;
 			rx_borrowed = 1;
 			stats.rx_packets++;
@@ -297,10 +315,21 @@ int ar_sdio_send(const uint8_t *data, size_t length)
 {
 	if (!ready || !length || length > AR_SDIO_BUFFER_SIZE) { return -1; }
 	if (tx_count == AR_SDIO_TX_DEPTH) { stats.tx_backpressure++; return -1; }
+#ifdef AR_SDIO_P1_TRAILER
+	/* The 00 DD length_le16 block tail of received_payload(). */
+	if (length > AR_SDIO_BUFFER_SIZE - 4) { return -1; }
+	size_t transfer = (length + 4 + AR_SDIO_BLOCK - 1) & ~(AR_SDIO_BLOCK - 1);
+#else
 	size_t transfer = (length + AR_SDIO_BLOCK - 1) & ~(AR_SDIO_BLOCK - 1);
+#endif
 	unsigned tail = (tx_head + tx_count) % AR_SDIO_TX_DEPTH;
 	memcpy(transmit_buffers[tail], data, length);
 	memset(transmit_buffers[tail] + length, 0, transfer - length);
+#ifdef AR_SDIO_P1_TRAILER
+	transmit_buffers[tail][transfer - 3] = 0xdd;
+	transmit_buffers[tail][transfer - 2] = length;
+	transmit_buffers[tail][transfer - 1] = length >> 8;
+#endif
 	transmit_lengths[tail] = transfer;
 	tx_count++;
 	if (tx_count > stats.tx_queue_high_water) { stats.tx_queue_high_water = tx_count; }
