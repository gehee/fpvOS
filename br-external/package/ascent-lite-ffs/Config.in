config BR2_PACKAGE_ASCENT_LITE_FFS
	bool "ascent-lite-ffs"
	depends on BR2_LINUX_KERNEL
	help
	  FunctionFS (usb_f_fs.ko) and CDC-NCM (usb_f_ncm.ko) for the
	  Ascent Lite and Lite+, whose stock kernel has the USB gadget's
	  configfs but neither function: the kernel's own f_fs.c and
	  f_ncm.c, built as modules against the image's kernel tree (the
	  stock kernel's version and vermagic). fpvOS_usb's bridge mode
	  loads usb_f_fs.ko; the USB network mode loads usb_f_ncm.ko.
