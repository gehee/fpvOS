+    struct v4l2_ext_controls cs={.count=3,.controls=controls};
+    ret=ioctl(sensor,VIDIOC_S_EXT_CTRLS,&cs) ? -errno : 0;
+    close(sensor);
+    if(ret) return ret;
 
     if (opts->no_ladders) {
         return 0;
@@ -503,6 +509,7 @@
 {
