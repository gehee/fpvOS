--- a/ml-aed/ml-aed-blob.h
+++ b/ml-aed/ml-aed-blob.h
@@ -13,7 +13,8 @@
 
 /* {gain Q8 u32, line_count u32}. Shipped configuration for the fixed FPV preview mode (1080p60, ceiling 1125 lines, gain ceiling 64.0), not something the vendor computes. Heap copy at state+0x68 agrees over all 366. */
 #define MLAED_EXPOSURE_TABLE_OFF    0xb6524u
-#define MLAED_EXPOSURE_TABLE_COUNT  366u
+#define MLAED_EXPOSURE_TABLE_COUNT  512u
+#define MLAED_EXPOSURE_COUNT_OFF    0xb6508u
 #define MLAED_EXPOSURE_TABLE_STRIDE 8u
 
 /* {index u32, target u32}, the luma target knots. Heap state+0x4000+184. */
--- a/ml-aed/ml-aed-tuning.c
+++ b/ml-aed/ml-aed-tuning.c
@@ -5,6 +5,7 @@
  * Named spans are pread individually: the AE payload is under 3 KiB against 859 KiB for the blob.
  */
 #include <errno.h>
+#include <math.h>
 #include <fcntl.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -54,6 +55,7 @@
     uint8_t word[4];
     struct stat st;
     int fd, ret;
+    uint32_t count;
 
     memset(t, 0, sizeof(*t));
 
@@ -74,6 +76,14 @@
         close(fd);
 
         return -EINVAL;
+    }
+
+    ret = read_span(fd, word, 4, MLAED_EXPOSURE_COUNT_OFF);
+    if (ret) { close(fd); return ret; }
+    count = le32(word);
+    if (count < 2 || count > MLAED_EXPOSURE_TABLE_COUNT) {
+        close(fd);
+        return ret ? ret : -EINVAL;
     }
 
     t->table = calloc(MLAED_EXPOSURE_TABLE_COUNT, sizeof(*t->table));
@@ -106,14 +116,14 @@
 
     /* 366 x {gain Q8, line_count}, one span. */
     if (!ret) {
-        size_t len = MLAED_EXPOSURE_TABLE_COUNT * MLAED_EXPOSURE_TABLE_STRIDE;
+        size_t len = count * MLAED_EXPOSURE_TABLE_STRIDE;
         uint8_t *raw = malloc(len);
 
         if (!raw) {
             ret = -ENOMEM;
         } else {
             ret = read_span(fd, raw, len, MLAED_EXPOSURE_TABLE_OFF);
-            for (unsigned int i = 0; !ret && i < MLAED_EXPOSURE_TABLE_COUNT; i++) {
+            for (unsigned int i = 0; !ret && i < count; i++) {
                 t->table[i].gain_q8 = le32(raw + i * MLAED_EXPOSURE_TABLE_STRIDE);
                 t->table[i].line_count = le32(raw + i * MLAED_EXPOSURE_TABLE_STRIDE + 4);
             }
@@ -129,7 +139,26 @@
         return ret;
     }
 
-    t->table_len = MLAED_EXPOSURE_TABLE_COUNT;
+    if (!isfinite(t->damping) || t->damping <= 0 || t->damping > 1 ||
+        !isfinite(t->log_ladder) || t->log_ladder <= 0 || t->tolerance > 255) {
+        ae_tuning_free(t);
+        return -EINVAL;
+    }
+    for (unsigned int i = 0; i < count; i++) {
+        if (!t->table[i].line_count || t->table[i].line_count > 65535 ||
+            !t->table[i].gain_q8 || t->table[i].gain_q8 > 0x1000000) {
+            ae_tuning_free(t);
+            return -EINVAL;
+        }
+    }
+    for (unsigned int i = 0; i < MLAED_TARGET_CURVE_COUNT; i++) {
+        if (t->curve[i].target < 1 || t->curve[i].target > 255 ||
+            (i && t->curve[i].index <= t->curve[i-1].index)) {
+            ae_tuning_free(t);
+            return -EINVAL;
+        }
+    }
+    t->table_len = count;
     t->index_min = 1;
     t->index_max = (int)t->table_len - 1;
 
--- a/ml-aed/ml-aed.c
+++ b/ml-aed/ml-aed.c
@@ -7,6 +7,9 @@
