-        return ret;
-    }
+    unsigned int ai=0, di=0;
+    while(ai+1<sizeof(analog)/sizeof(analog[0]) && analog[ai+1]<=gain_q8*4U) ai++;
+    unsigned int residual = (unsigned long long)gain_q8 * 4096 / analog[ai];
