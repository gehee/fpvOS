  * climb indices that no longer brighten the picture (and would have to come
  * back down through them, unseen, when the light returns).
  */
+/*
+ * fpvOS: the table's line counts are 1080p60 lines (ML_AED_LINE_NS). A mode with
+ * another line (the SC231AI's 720p window: 11.1 us at 120 fps) takes the same
+ * exposure time, in its own lines.
+ */
+static uint32_t ae_mode_lines(const struct ae_opts *opts, uint32_t table_lines)
+{
+    if (!opts->line_ns || opts->line_ns == ML_AED_LINE_NS) {
+        return table_lines;
+    }
+    uint64_t lines = ((uint64_t)table_lines * ML_AED_LINE_NS + opts->line_ns / 2) / opts->line_ns;
+    return lines ? (uint32_t)lines : 1;
+}
+
+/*
+ * fpvOS: the sensor's line and longest exposure in the mode it runs, from its
+ * subdevice: a line is the width and the horizontal blanking at the pixel rate.
+ * --line-ns, when given, keeps its value. 0, or -errno when it cannot be read.
+ */
+static int ae_sensor_mode(struct ae_opts *opts, int line_given)
+{
+    int fd = open(opts->sensor_device, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        return -errno;
+    }
+    struct v4l2_subdev_format f = { .which = V4L2_SUBDEV_FORMAT_ACTIVE, .pad = 0 };
+    struct v4l2_ext_control c[2] = { { .id = V4L2_CID_PIXEL_RATE }, { .id = V4L2_CID_HBLANK } };
+    struct v4l2_ext_controls cs = { .which = V4L2_CTRL_WHICH_CUR_VAL, .count = 2, .controls = c };
+    struct v4l2_queryctrl q = { .id = V4L2_CID_EXPOSURE };
+    int ok = !ioctl(fd, VIDIOC_SUBDEV_G_FMT, &f) && !ioctl(fd, VIDIOC_G_EXT_CTRLS, &cs) &&
+             !ioctl(fd, VIDIOC_QUERYCTRL, &q) && c[0].value64 > 0 && c[1].value >= 0 &&
+             q.maximum > 0;
+    int e = errno;
+    close(fd);
+    if (!ok) {
+        return -e;
+    }
+    if (!line_given) {
+        /* Rounded: 1080p60's 2240 / 151.2 MHz is the table's own 14815. */
+        opts->line_ns = (unsigned int)(((f.format.width + (uint64_t)c[1].value) * 1000000000ull +
+                                        (uint64_t)c[0].value64 / 2) / (uint64_t)c[0].value64);
+    }
+    opts->exp_max = (unsigned int)q.maximum;
+    printf("ml-aed: sensor %ux%u, line %u ns, exposure up to %u lines\n",
+           f.format.width, f.format.height, opts->line_ns, opts->exp_max);
+    fflush(stdout);
+    return 0;
+}
+
