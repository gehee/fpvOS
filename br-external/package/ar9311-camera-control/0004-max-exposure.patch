 /*
+ * fpvOS: the most gain the sensor has, analog times digital, in Q8.
+ */
+static uint32_t ae_gain_q8_max(void)
+{
+    return (uint32_t)((uint64_t)analog[sizeof(analog) / sizeof(analog[0]) - 1] *
+                      digital[sizeof(digital) / sizeof(digital[0]) - 1] / 1024 / 4);
+}
+
+/*
+ * fpvOS: the exposure cap (--max-exposure-us). The table lengthens the
+ * exposure first and raises the gain only from 10 ms (index ~210), so indoors
+ * the sensor sits at 10 ms: motion blur, and half of it added to the latency
+ * of what the picture shows. Past the cap the exposure stays at the cap and
+ * the gain makes up the rest, so exposure x gain, what the index stands for,
+ * is kept until the sensor runs out of gain. Returns the lines to use.
+ */
+static uint32_t ae_cap_exposure(uint32_t cap_lines, uint32_t lines, uint32_t *gain_q8)
+{
+    if (!cap_lines || lines <= cap_lines) {
+        return lines;
+    }
+
+    uint64_t gain = (uint64_t)*gain_q8 * lines / cap_lines;
+    *gain_q8 = gain > ae_gain_q8_max() ? ae_gain_q8_max() : (uint32_t)gain;
+
+    return cap_lines;
+}
+
+/*
+ * fpvOS: take a cap (0: none), in lines, and the index past which the capped
+ * sensor has no gain left to follow the table: the AE stops there rather than
+ * climb indices that no longer brighten the picture (and would have to come
+ * back down through them, unseen, when the light returns).
+ */
+static void ae_set_cap(struct ae_opts *opts, const struct ae_tuning *tune, long us)
+{
+    opts->cap_us = us;
+    opts->cap_lines = 0;
+    opts->cap_ceil = 0;
+    if (us > 0) {
+        uint64_t lines = (uint64_t)us * 1000 / (opts->line_ns ? opts->line_ns : ML_AED_LINE_NS);
+        int top = tune->index_max;
+
+        opts->cap_lines = lines ? (uint32_t)lines : 1;
+        while (top > tune->index_min &&
+               (uint64_t)tune->table[top].gain_q8 * tune->table[top].line_count >
+               (uint64_t)ae_gain_q8_max() * opts->cap_lines) {
+            top--;
+        }
+        opts->cap_ceil = top;
+        printf("ml-aed: exposure capped at %ld us (%u lines), gain up to %.0fx, index up to %d\n",
+               us, opts->cap_lines, (double)ae_gain_q8_max() / 256.0, top);
+    } else {
+        printf("ml-aed: exposure not capped (the table's own)\n");
+    }
+    fflush(stdout);
+}
+
+/* fpvOS: the cap file's us, or `fallback` when it is missing or unreadable. */
+static long read_cap_file(const char *path, long fallback)
+{
+    char buf[16], *end;
+    FILE *f = fopen(path, "r");
+    long us;
+
+    if (!f) {
+        return fallback;
+    }
+    if (!fgets(buf, sizeof buf, f)) {
+        buf[0] = '\0';
+    }
+    fclose(f);
+    us = strtol(buf, &end, 10);
+    if (end == buf || (*end && *end != '\n') || us < 0 || us > 1000000) {
+        return fallback;
+    }
+
+    return us;
+}
+
