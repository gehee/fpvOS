     int banding;                /* mains anti-flicker: 0 off, 50 or 60 Hz */
     unsigned int line_ns;       /* sensor line time, for the anti-flicker snap */
+    unsigned int cap_lines;     /* fpvOS: the exposure cap in lines, 0 = the table's own */
+    long cap_us;                /* fpvOS: the same in us, as asked */
+    int cap_ceil;               /* fpvOS: the last index the capped sensor still reaches, 0 = none */
