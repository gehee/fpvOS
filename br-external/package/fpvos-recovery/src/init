#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mkdir -m 700 /run/fpvos-update
# Adopt the bootloader guard before verifying or unpacking the NAND bundle.
[ ! -e /etc/fpvos-watchdog ] || watchdog -t 5 -T 60 /dev/watchdog

# A missing, damaged or mismatched bundle leaves this independent recovery
# root running. Only the explicit clean flag is consumed by the NAND helper.
if /usr/sbin/ar9311-nandctl boot; then
    root_image=/run/fpvos-root/$(cat /etc/fpvos-recovery-root)
    case "$root_image" in
        *.uboot) tail -c +65 "$root_image" > /run/rootfs.gz ;;
        *.gz) mv "$root_image" /run/rootfs.gz ;;
        *) exit 1 ;;
    esac
    if gzip -t /run/rootfs.gz &&
       mount -t tmpfs -o mode=0755 tmpfs /newroot &&
       (cd /newroot && gzip -dc /run/rootfs.gz | cpio -idm) &&
       [ -x /newroot/sbin/init ] && [ -x /newroot/usr/sbin/fpvos-update-service ]; then
        sha256sum /run/fpvos-update/boot.fwu | cut -d ' ' -f 1 > /newroot/etc/fpvos-installed-sha256
        : > /newroot/etc/fpvos-nand-boot
        umount /sys
        umount /proc
        umount /run
        umount /tmp
        mount --move /dev /newroot/dev
        exec switch_root -c /dev/console /newroot /sbin/init
    fi
    echo 'NAND root unpack failed; entering USB recovery'
else
    echo 'Clean request or invalid NAND root; entering USB recovery'
fi
umount /newroot 2>/dev/null || :
rm -rf /run/fpvos-root /run/fpvos-update/boot.fwu /run/rootfs.gz
: > /run/fpvos-clean-boot
exec /sbin/init
