config BR2_PACKAGE_KESTREL_AIR
	bool "kestrel-air"
	depends on BR2_arm || (BR2_aarch64 && BR2_FPVOS_SOC_AR9311)
	select BR2_PACKAGE_HI3516CV610_SDK if BR2_arm
	select BR2_PACKAGE_AR_LIBRE
	help
	  fpvOS air application: shared AR8030 transport and video protocol,
	  with a HiSilicon MPI or AR9311 Linux V4L2 camera backend.

if BR2_PACKAGE_KESTREL_AIR
config BR2_PACKAGE_KESTREL_AIR_AR9311
	bool
	default y if BR2_FPVOS_SOC_AR9311
	select BR2_PACKAGE_AR9311_CAMERA_CONTROL
	select BR2_PACKAGE_AR9311_CAPTURE
endif
