#!/bin/sh
# Explicit source-camera launcher; the OS owns module loading and board policy.
set -eu
STATE_DIR=/var/lib/kestrel-air
PERSISTENT_STATE=0
[ ! -r /etc/default/kestrel-air ] || . /etc/default/kestrel-air
if [ "$PERSISTENT_STATE" = 1 ] &&
    ! awk -v point="$STATE_DIR" '$2 == point && $3 == "ubifs" && $4 ~ /(^|,)rw(,|$)/ { ok=1 } END { exit !ok }' /proc/mounts; then
    # Start on defaults rather than refuse: radio without video is worse than
    # settings that are not kept. A RAM directory, not the empty mountpoint,
    # so S45settings can still mount the volume later.
    warning='persistent settings unavailable (see S45settings): running on defaults in RAM, changes are not saved'
    echo "WARNING: $warning" >&2
    echo "<4>kestrel-air: $warning" 2>/dev/null >/dev/kmsg || :
    STATE_DIR=/run/kestrel-air-settings
fi
. /etc/default/ar9311-camera
: "${SENSOR_MODULE:?}" "${TUNING:?}" "${WB_RED:?}" "${WB_BLUE:?}" "${WB_STATS_ORDER:?}"
[ -c /dev/arlink0 ] || { echo 'Start/provision the radio first' >&2; exit 1; }
exec 9>/run/ar9311-camera.lock
flock -n 9 || { echo 'Camera already in use' >&2; exit 1; }
# Workers inherit the lock; the supervisor reaps survivors after a crash.
grep -q ' /sys/kernel/debug debugfs ' /proc/mounts || mount -t debugfs debugfs /sys/kernel/debug
modprobe artosyn_gpio
modprobe clk-ar9311-cgu
modprobe "$SENSOR_MODULE"
modprobe ar-csi2
modprobe ar-vif
modprobe ar-isp gates=1 seed=0
# depth 2: each buffer reaches the encoder one frame (16.7 ms) sooner than at
# the default 3. With an exposure toggled every 100 ms, 600 pictures at 2 and
# at 3 came out whole, while at 1 half of them mixed two frames.
modprobe ar-cvisp assert_clk=1 depth=2
# kestrel-air reads a frame's rows as they land (KA_EARLY_ROW): depth 1 for its
# streams, 5.5 ms sooner again (0008-depth-per-stream.patch; read at stream start).
echo 1 > /sys/module/ar_cvisp/parameters/depth
modprobe wave5
# The SoC temperature kestrel-air sends the ground (hwmon ar9311_temp).
modprobe ar9311_temp || :
export KA_CAMERA_TUNING="$TUNING" KA_WB_RED="$WB_RED" KA_WB_BLUE="$WB_BLUE" KA_WB_ORDER="$WB_STATS_ORDER"
mkdir -p -m 0700 "$STATE_DIR"
export KA_CONFIG="$STATE_DIR/settings.json"
export KA_PEER_CONFIG="$STATE_DIR/peer.json"
export KA_READY_FILE=/run/kestrel-air/ready
rm -f "$KA_READY_FILE"
exec /usrdata/fpv/air/kestrel-air ${MAX_EXPOSURE_US:+--max-exposure-us "$MAX_EXPOSURE_US"} "$@"
