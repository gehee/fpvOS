From: fpvOS developers
Subject: [PATCH] media: ar-isp: saturation and contrast a pilot can set

Two percent-of-tuning adjustments, 100 leaving every register and table
byte as before. Saturation scales the chroma rows of the colour-space
matrix (words 2 to 5 of the rgb2yuv bank hold only Cb and Cr coefficients;
the luma row stays). Contrast stretches the gamma curve about mid-scale
after the tuning blend, clamped to the 12-bit output, at configure and at
every tone rebuild. Both are module parameters and debugfs files
(saturation, contrast) that apply to a running ISP; a mutex serialises the
contrast rebuild with the AE's tone writes. Out of range, the module
parameters are refused as the debugfs files are (0-200, contrast 50-200).

Upstream: not submitted

--- a/overlay/drivers/media/artosyn/ar-isp-codec.h
+++ b/overlay/drivers/media/artosyn/ar-isp-codec.h
@@ -174,9 +174,23 @@
  * The monotonic clamp matters: the hardware reads a transfer curve, and a
  * non-monotonic entry inverts the response over that interval.
  */
-static inline void ar_isp_gamma_from_blob(u8 *dst, const u8 *blob,
-					  unsigned int low, unsigned int high,
-					  u32 t_q12)
+/*
+ * fpvOS: contrast, the curve stretched about mid-scale (AR_ISP_GAMMA_MID) by
+ * contrast_pct / 100 after the blend and clamped to the 12-bit output. 100 is
+ * the tuning file's curve unchanged; the monotonic clamp below still holds.
+ */
+#define AR_ISP_GAMMA_MID	0x800
+
+static inline u16 ar_isp_gamma_contrast(u32 v, int pct)
+{
+	int c = AR_ISP_GAMMA_MID + ((int)v - AR_ISP_GAMMA_MID) * pct / 100;
+
+	return c < 0 ? 0 : c > 0xfff ? 0xfff : c;
+}
+
+static inline void ar_isp_gamma_from_blob_contrast(u8 *dst, const u8 *blob,
+						   unsigned int low, unsigned int high,
+						   u32 t_q12, int contrast_pct)
 {
 	const u8 *curve = blob + AR_ISP_GAMMA_BLOB_OFFSET + low * AR_ISP_GAMMA_BLOB_STRIDE;
 	const u8 *other = blob + AR_ISP_GAMMA_BLOB_OFFSET + high * AR_ISP_GAMMA_BLOB_STRIDE;
@@ -195,6 +209,8 @@
 		samples[i] = ar_isp_tone_blend(ar_isp_get_le32(curve + at),
 					       ar_isp_get_le32(other + at),
 					       t_q12) & 0xfff;
+		if (contrast_pct != 100)
+			samples[i] = ar_isp_gamma_contrast(samples[i], contrast_pct);
 	}
 
 	for (i = 1; i < AR_ISP_GAMMA_SAMPLES; i++)
@@ -213,12 +229,21 @@
 			ar_isp_get_le32(other + (AR_ISP_GAMMA_BLOB_ENTRIES - 1) * 4),
 			t_q12) & 0xfff;
 
+	if (contrast_pct != 100)
+		tail = ar_isp_gamma_contrast(tail, contrast_pct);
 	if (tail < samples[AR_ISP_GAMMA_SAMPLES - 1])
 		tail = samples[AR_ISP_GAMMA_SAMPLES - 1];
 
 	ar_isp_gamma_pack_page(dst, samples, tail);
 }
 
+static inline void ar_isp_gamma_from_blob(u8 *dst, const u8 *blob,
+					  unsigned int low, unsigned int high,
+					  u32 t_q12)
+{
+	ar_isp_gamma_from_blob_contrast(dst, blob, low, high, t_q12, 100);
+}
+
