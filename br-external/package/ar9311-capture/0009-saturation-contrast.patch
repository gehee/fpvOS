 DEFINE_DEBUGFS_ATTRIBUTE(ar_isp_tone_fops, NULL, ar_isp_tone_set, "%llu\n");
 
+/* fpvOS: Saturation and Contrast, percent of the tuning's (100 unchanged). */
+static int ar_isp_saturation_set(void *data, u64 val)
+{
+	return val > 200 ? -ERANGE : ar_isp_set_saturation(data, (int)val);
+}
+
+static int ar_isp_saturation_get(void *data, u64 *val)
+{
+	*val = ar_isp_get_saturation();
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(ar_isp_saturation_fops, ar_isp_saturation_get,
+			 ar_isp_saturation_set, "%llu\n");
+
+static int ar_isp_contrast_set(void *data, u64 val)
+{
+	int ret;
+
+	if (val > 200)
+		return -ERANGE;
+	mutex_lock(&ar_isp_tone_mutex);
+	ret = ar_isp_set_contrast(data, (int)val);
+	mutex_unlock(&ar_isp_tone_mutex);
+	return ret;
+}
+
+static int ar_isp_contrast_get(void *data, u64 *val)
+{
+	*val = ar_isp_get_contrast();
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(ar_isp_contrast_fops, ar_isp_contrast_get,
+			 ar_isp_contrast_set, "%llu\n");
