 static int csc = AR_ISP_CSC_DEFAULT;
 module_param(csc, int, 0644);
+/*
+ * fpvOS: the picture adjustments a pilot sets (the goggle's Saturation and
+ * Contrast), in percent of the tuning's, 100 unchanged. Saturation scales the
+ * chroma rows of the colour-space matrix; contrast stretches the gamma curve
+ * about mid-scale. debugfs saturation and contrast set them on a running ISP.
+ */
+static int saturation = 100;
+static int contrast = 100;
+/*
+ * Range-checked as the debugfs files are: an int out of range overflowed the
+ * contrast stretch or wrapped a negative saturation into garbage chroma.
+ */
+static int ar_isp_param_in(const char *val, const struct kernel_param *kp, int lo, int hi)
+{
+	int v, ret = kstrtoint(val, 0, &v);
+
+	if (ret)
+		return ret;
+	if (v < lo || v > hi)
+		return -ERANGE;
+	*(int *)kp->arg = v;
+	return 0;
+}
+
+static int ar_isp_saturation_param(const char *val, const struct kernel_param *kp)
+{
+	return ar_isp_param_in(val, kp, 0, 200);
+}
+
+static int ar_isp_contrast_param(const char *val, const struct kernel_param *kp)
+{
+	return ar_isp_param_in(val, kp, 50, 200);
+}
+
+static const struct kernel_param_ops ar_isp_saturation_ops = {
+	.set = ar_isp_saturation_param,
+	.get = param_get_int,
+};
+static const struct kernel_param_ops ar_isp_contrast_ops = {
+	.set = ar_isp_contrast_param,
+	.get = param_get_int,
+};
+module_param_cb(saturation, &ar_isp_saturation_ops, &saturation, 0644);
+MODULE_PARM_DESC(saturation, "chroma gain in percent, 0-200 (100: the matrix as is)");
+module_param_cb(contrast, &ar_isp_contrast_ops, &contrast, 0644);
+MODULE_PARM_DESC(contrast, "gamma stretch about mid-scale in percent, 50-200 (100: the tuning's curve)");
 MODULE_PARM_DESC(csc,
 		 "colour-space matrix index: 0 bt601_full (the vendor's), 1 bt709_full, 2 bt601_limited, 3 bt709_limited; -1 leaves the replayed bank alone");
 
@@ -915,6 +961,14 @@
  * ones at 16 and 235, and that decision reaches everything downstream of the
  * ISP including the encoder and the DVR file.
  */
+/* fpvOS: one sign-magnitude Q10 field scaled by pct / 100. */
+static u32 ar_isp_csc_scale(u32 field, int pct)
+{
+	u32 mag = (field & 0x7fff) * (u32)pct / 100;
+
+	return (field & 0x8000) | min_t(u32, mag, 0x7fff);
+}
+
 void ar_isp_rgb2yuv_apply(struct ar_isp *isp)
 {
 	const struct ar_isp_csc *m;
@@ -930,8 +984,50 @@
 
 	m = &ar_isp_csc_matrices[csc];
 
-	for (unsigned int i = 0; i < AR_ISP_RGB2YUV_REGS; i++)
-		writel(m->regs[i], isp->base + AR_ISP_RGB2YUV_BANK + i * 4);
+	/*
+	 * fpvOS: words 2 to 5 hold only chroma coefficients (Cb and Cr rows,
+	 * see gen-rgb2yuv.py's pairing), so scaling every field there is the
+	 * saturation; words 0 and 1 are luma and stay.
+	 */
+	for (unsigned int i = 0; i < AR_ISP_RGB2YUV_REGS; i++) {
+		u32 w = m->regs[i];
+
+		if (i >= 2 && saturation != 100)
+			w = ar_isp_csc_scale(w >> 16, saturation) << 16 |
+			    ar_isp_csc_scale(w & 0xffff, saturation);
+		writel(w, isp->base + AR_ISP_RGB2YUV_BANK + i * 4);
+	}
+}
+
+int ar_isp_set_saturation(struct ar_isp *isp, int pct)
+{
+	if (pct < 0 || pct > 200)
+		return -ERANGE;
+	saturation = pct;
+	if (isp->configured)
+		ar_isp_rgb2yuv_apply(isp);
+	return 0;
+}
+
+int ar_isp_get_saturation(void)
+{
+	return saturation;
+}
+
+/* The caller serialises this with the other tone rebuilds. */
+int ar_isp_set_contrast(struct ar_isp *isp, int pct)
+{
+	if (pct < 50 || pct > 200)
+		return -ERANGE;
+	contrast = pct;
+	if (isp->configured)
+		ar_isp_tone_apply(isp, true, false);
+	return 0;
+}
+
+int ar_isp_get_contrast(void)
+{
+	return contrast;
 }
 
