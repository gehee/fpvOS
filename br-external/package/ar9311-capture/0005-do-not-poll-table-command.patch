From: fpvOS developers
Subject: [PATCH] media: do not treat table command bits as a completion flag

--- a/overlay/drivers/media/artosyn/ar-isp-main.c
+++ b/overlay/drivers/media/artosyn/ar-isp-main.c
@@ -45,7 +45,6 @@
 #include <linux/platform_device.h>
 #include <linux/slab.h>
 #include <media/v4l2-subdev.h>
-#include <linux/iopoll.h>
 
 #include "vendor-tables/ar-isp-defaults.h"
 #include "vendor-tables/ar-isp-gates.h"
@@ -793,10 +792,10 @@
 		writel(0x100, isp->base + 0x0064);
 		writel(0x100, isp->base + 0x0068);
 		writel(0x1001e, isp->base + AR_ISP_TABLE_COMMIT);
-		ret = readl_poll_timeout(isp->base + AR_ISP_TABLE_COMMIT,
-					val, !(val & 0x1e), 10, 100000);
-		if (ret)
-			return ret;
+		/* This is a command register, not a documented completion flag.
+		 * Some cold starts retain the written value while frames continue.
+		 */
+		readl(isp->base + AR_ISP_TABLE_COMMIT);
 	}
 
 
