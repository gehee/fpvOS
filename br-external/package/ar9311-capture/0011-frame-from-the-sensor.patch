From: fpvOS developers
Subject: [PATCH] media: ar-isp, ar-cvisp: the frame the sensor sends, not only 1080p

The ISP and CVISP replays were recorded at 1920x1080. The sensor's active
format, which the VIF reports at pipeline start, now sets the frame: the
registers the provenance audit attributes to the frame (frame geometry, and
the statistics windows whose library image is the 1080p frame) are rewritten
for it as they are replayed (ar-frame-geom.h), in the same spellings the
audit recognises: bare, half, padded and packed dimensions, and de3d's
8-pixel grid. Strides stay 2048/1024 and the buffers stay 1080p-sized.
CVISP reports the frame in its format and payloads. 1080p writes exactly
what it did before.

LTM keeps its 1080p frame (0x2804): its tile registers describe the 1080p
grid, and a shortened frame darkened the picture and stepped it down 18% at
row 675, the sixth tile row. Its page is an identity curve.

The ISP takes fewer rows of the 1080p line (the SC231AI's 1920x720 at
90 fps, measured on the P1: ISP input 0x02d00780, 90.1 fps captured): de3d's
recovered line delay is for that line, so the width stays 1920.

Upstream: not submitted

diff --git a/overlay/drivers/media/artosyn/ar-cvisp.c b/overlay/drivers/media/artosyn/ar-cvisp.c
index ed3a153..abef33a 100644
--- a/overlay/drivers/media/artosyn/ar-cvisp.c
+++ b/overlay/drivers/media/artosyn/ar-cvisp.c
@@ -58,6 +58,8 @@
 #include <media/videobuf2-v4l2.h>
 
 #include "vendor-tables/ar-cvisp-derived.h"
+#include "ar-frame-geom.h"
+#include <media/v4l2-mediabus.h>
 #include "ar-isp-blc.h"
 
 /*
@@ -121,8 +123,9 @@
 
 /* Y, U and V: the block writes three separate plane bases. */
 #define AR_CVISP_PLANES			3
-#define AR_CVISP_Y_SIZE			(AR_CVISP_Y_STRIDE * AR_CVISP_HEIGHT)
-#define AR_CVISP_C_SIZE			(AR_CVISP_C_STRIDE * (AR_CVISP_HEIGHT / 2))
+/* The buffers are sized for 1080p; a smaller frame (the sensor's, see
+ * ar_cvisp_frame) is written into them at the same strides.
+ */
 
 /*
  * Rows the buffers hold, above the rows the block writes.
@@ -296,8 +299,45 @@ struct ar_cvisp {
 	u32 drops;		/* ticks with nothing queued to arm */
 	void *scratch[AR_CVISP_PLANES];
 	dma_addr_t scratch_dma[AR_CVISP_PLANES];
+	u32 frame_w, frame_h;	/* the frame the block was configured for */
+};
+
+/*
+ * The registers of the setup and late tables that hold the frame, at full or
+ * half (chroma) size, which check-cvisp-derivation.py classes as frame
+ * geometry. Strides (0x08000800, 0x809c, 0x81b4) are not among them: a
+ * smaller frame keeps the 2048 and 1024 byte lines.
+ */
+static const u16 ar_cvisp_frame_regs[] = {
+	0x4000, 0x4004, 0x4008, 0x400c, 0x4104, 0x410c,
+	0x8008, 0x8010, 0x8028, 0x8030, 0x8034, 0x8044, 0x8050, 0x8058,
+	0x805c, 0x8078, 0x8080, 0x8084, 0x8094, 0x80a0, 0x80a8, 0x80ac,
+	0x80bc, 0x80c8, 0x80d0, 0x80d4, 0x80e4, 0x80f0, 0x80f8, 0x80fc,
+	0x8134, 0x8140, 0x8148, 0x814c, 0x815c,
 };
 
+/*
+ * The frame: as configured once the block is, before that the sensor's
+ * current format (its module parameter or V4L2 format picks the mode), which
+ * is what the chain will be brought up with. 1080p if neither is known.
+ */
+static void ar_cvisp_frame(struct ar_cvisp *cv, u32 *w, u32 *h)
+{
+	struct v4l2_mbus_framefmt fmt;
+
+	*w = AR_CVISP_WIDTH;
+	*h = AR_CVISP_HEIGHT;
+	if (cv->frame_w) {
+		*w = cv->frame_w;
+		*h = cv->frame_h;
+	} else if (!ar_vif_get_input_format(&fmt) && fmt.width && fmt.height &&
+		   fmt.width <= AR_CVISP_WIDTH && fmt.height <= AR_CVISP_HEIGHT &&
+		   !(fmt.width % 8) && !(fmt.height % 8)) {
+		*w = fmt.width;
+		*h = fmt.height;
+	}
+}
+
 static inline struct ar_cvisp_buffer *to_ar_cvisp_buffer(struct vb2_v4l2_buffer *vb)
 {
 	return container_of(vb, struct ar_cvisp_buffer, vb);
@@ -335,6 +375,12 @@ static void ar_cvisp_apply(struct ar_cvisp *cv, const struct ar_cvisp_reg *tbl,
 			val = lower_32_bits(cv->scratch_dma[1]);
 		else if (tbl[i].off == AR_CVISP_PLANE_V)
 			val = lower_32_bits(cv->scratch_dma[2]);
+		else if (cv->frame_w && (cv->frame_w != AR_FRAME_REF_W ||
+					 cv->frame_h != AR_FRAME_REF_H))
+			for (size_t j = 0; j < ARRAY_SIZE(ar_cvisp_frame_regs); j++)
+				if (ar_cvisp_frame_regs[j] == tbl[i].off)
+					val = ar_frame_geom_remap(val, cv->frame_w,
+								  cv->frame_h);
 		writel(val, cv->base + tbl[i].off);
 	}
 }
@@ -600,6 +646,11 @@ static void ar_cvisp_blc_apply(struct ar_cvisp *cv)
  */
 static void ar_cvisp_configure(struct ar_cvisp *cv, bool late)
 {
+	u32 w, h;
+
+	ar_cvisp_frame(cv, &w, &h);
+	cv->frame_w = w;
+	cv->frame_h = h;
 	ar_cvisp_apply(cv, ar_cvisp_setup, ARRAY_SIZE(ar_cvisp_setup));
 
 	if (late)
@@ -618,8 +669,8 @@ static void ar_cvisp_configure(struct ar_cvisp *cv, bool late)
 	cv->configured = true;
 
 	dev_info(cv->dev,
-		 "configured: %zu setup + %zu late, control 0x%08x, plane_y 0x%08x\n",
-		 ARRAY_SIZE(ar_cvisp_setup), late ? ARRAY_SIZE(ar_cvisp_late) : 0,
+		 "configured %ux%u: %zu setup + %zu late, control 0x%08x, plane_y 0x%08x\n",
+		 w, h, ARRAY_SIZE(ar_cvisp_setup), late ? ARRAY_SIZE(ar_cvisp_late) : 0,
 		 readl(cv->base + AR_CVISP_CONTROL),
 		 readl(cv->base + AR_CVISP_PLANE_Y));
 }
@@ -711,12 +762,16 @@ DEFINE_SHOW_ATTRIBUTE(ar_cvisp_regs);
  * Geometry is not negotiable. It is the geometry ar_cvisp_setup configures the
  * block for, and changing it would mean changing that replay.
  */
-static void ar_cvisp_fill_format(struct v4l2_pix_format_mplane *pix)
+static void ar_cvisp_fill_format(struct ar_cvisp *cv,
+				 struct v4l2_pix_format_mplane *pix)
 {
+	u32 w, h;
+
+	ar_cvisp_frame(cv, &w, &h);
 	memset(pix, 0, sizeof(*pix));
 
-	pix->width = AR_CVISP_WIDTH;
-	pix->height = AR_CVISP_HEIGHT;
+	pix->width = w;
+	pix->height = h;
 	pix->pixelformat = V4L2_PIX_FMT_YUV420M;
 	pix->field = V4L2_FIELD_NONE;
 	pix->num_planes = AR_CVISP_PLANES;
@@ -784,12 +839,14 @@ static int ar_cvisp_buffer_prepare(struct vb2_buffer *vb)
 		AR_CVISP_C_ALLOC,
 		AR_CVISP_C_ALLOC,
 	};
-	static const unsigned int plane_written[AR_CVISP_PLANES] = {
-		AR_CVISP_Y_SIZE,
-		AR_CVISP_C_SIZE,
-		AR_CVISP_C_SIZE,
-	};
+	struct ar_cvisp *cv = vb2_get_drv_priv(vb->vb2_queue);
 	struct ar_cvisp_buffer *buf = to_ar_cvisp_buffer(to_vb2_v4l2_buffer(vb));
+	unsigned int plane_written[AR_CVISP_PLANES];
+	u32 w, h;
+
+	ar_cvisp_frame(cv, &w, &h);
+	plane_written[0] = AR_CVISP_Y_STRIDE * h;
+	plane_written[1] = plane_written[2] = AR_CVISP_C_STRIDE * (h / 2);
 
 	for (unsigned int i = 0; i < ARRAY_SIZE(plane_alloc); i++) {
 		if (vb2_plane_size(vb, i) < plane_alloc[i])
@@ -948,7 +1005,7 @@ static int ar_cvisp_start_streaming(struct vb2_queue *q, unsigned int count)
 	spin_unlock_irqrestore(&cv->buffer_lock, flags);
 
 	dev_info(cv->dev, "streaming: %ux%u YUV420M, %u buffers, depth %u\n",
-		 AR_CVISP_WIDTH, AR_CVISP_HEIGHT, count, cv->depth);
+		 cv->frame_w, cv->frame_h, count, cv->depth);
 
 	return 0;
 }
@@ -1017,7 +1074,7 @@ static int ar_cvisp_enum_fmt(struct file *file, void *priv,
 static int ar_cvisp_get_fmt(struct file *file, void *priv,
 			    struct v4l2_format *f)
 {
-	ar_cvisp_fill_format(&f->fmt.pix_mp);
+	ar_cvisp_fill_format(video_drvdata(file), &f->fmt.pix_mp);
 
 	return 0;
 }
@@ -1029,8 +1086,8 @@ static int ar_cvisp_enum_framesizes(struct file *file, void *priv,
 		return -EINVAL;
 
 	fsize->type = V4L2_FRMSIZE_TYPE_DISCRETE;
-	fsize->discrete.width = AR_CVISP_WIDTH;
-	fsize->discrete.height = AR_CVISP_HEIGHT;
+	ar_cvisp_frame(video_drvdata(file), &fsize->discrete.width,
+		       &fsize->discrete.height);
 
 	return 0;
 }
diff --git a/overlay/drivers/media/artosyn/ar-frame-geom.h b/overlay/drivers/media/artosyn/ar-frame-geom.h
new file mode 100644
index 0000000..c290f79
--- /dev/null
+++ b/overlay/drivers/media/artosyn/ar-frame-geom.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * ar-frame-geom.h - the replayed configuration at another frame size.
+ *
+ * The ISP and CVISP replays were recorded at 1920x1080. Where a replayed
+ * register holds the frame, it holds it in one of a few spellings, which
+ * scripts/isp/audit-provenance.py (its GEOMETRY set) and
+ * check-cvisp-derivation.py (geometry_words) already enumerate:
+ *
+ *   bare       1920, 1080, half 960 and 540, padded 1928 (de3d's border)
+ *   packed     two of those, high and low half: W<<16|H, H<<16|W, W<<16|W
+ *   grid8      de3d's 8-pixel grid of the padded frame, 241<<16|135
+ *
+ * ar_frame_geom_remap() rewrites such a value for a frame of w x h, so
+ * 1080p's replay drives a 720p frame. It is applied only to the registers
+ * the audit attributes to the frame (the lists in the drivers), never by
+ * value alone: 0x780 is also a descriptor length (ISP 0x0024), and the
+ * strides (2048) stay as they are, since a 1280-pixel line fits in a 2048 one.
+ * A value the remap does not recognise is returned unchanged.
+ */
+#ifndef AR_FRAME_GEOM_H
+#define AR_FRAME_GEOM_H
+
+#include <linux/math.h>
+#include <linux/types.h>
+
+#define AR_FRAME_REF_W		1920
+#define AR_FRAME_REF_H		1080
+
+static inline bool ar_frame_geom_dim(u32 v, u32 w, u32 h, u32 *out)
+{
+	switch (v) {
+	case AR_FRAME_REF_W:		*out = w; return true;
+	case AR_FRAME_REF_H:		*out = h; return true;
+	case AR_FRAME_REF_W / 2:	*out = w / 2; return true;
+	case AR_FRAME_REF_H / 2:	*out = h / 2; return true;
+	case AR_FRAME_REF_W + 8:	*out = w + 8; return true;
+	}
+	return false;
+}
+
+static inline u32 ar_frame_geom_remap(u32 v, u32 w, u32 h)
+{
+	u32 hi, lo;
+
+	if (w == AR_FRAME_REF_W && h == AR_FRAME_REF_H)
+		return v;
+	/* de3d's grid: the padded width and the height in 8-pixel blocks. */
+	if (v == ((((AR_FRAME_REF_W + 8) / 8) << 16) | (AR_FRAME_REF_H / 8)))
+		return ((DIV_ROUND_UP(w + 8, 8)) << 16) | DIV_ROUND_UP(h, 8);
+	if (ar_frame_geom_dim(v, w, h, &lo))
+		return lo;
+	if (ar_frame_geom_dim(v >> 16, w, h, &hi) &&
+	    ar_frame_geom_dim(v & 0xffff, w, h, &lo))
+		return (hi << 16) | lo;
+	return v;
+}
+
+#endif /* AR_FRAME_GEOM_H */
diff --git a/overlay/drivers/media/artosyn/ar-isp-main.c b/overlay/drivers/media/artosyn/ar-isp-main.c
index ce66c43..a5a5c53 100644
--- a/overlay/drivers/media/artosyn/ar-isp-main.c
+++ b/overlay/drivers/media/artosyn/ar-isp-main.c
@@ -812,6 +812,17 @@ int ar_isp_pipeline_start(void)
 	    !isp->tone || !isp->rro || !isp->rro_face || !isp->hist ||
 	    !isp->ltm_page || !isp->ltm_stats || !isp->de3d[0] ||
 	    !isp->de3d[1] || !isp->de3d[2]) return -ENOMEM;
+	/* Fewer rows only: the lines stay the 1080p mode's, the one line de3d's
+	 * recovered delay (AR_ISP_DE3D_HTS) is for.
+	 */
+	if (fmt.width != AR_FRAME_REF_W || fmt.height > AR_FRAME_REF_H ||
+	    fmt.height % 8)
+		return -EINVAL;
+	isp->frame_w = fmt.width;
+	isp->frame_h = fmt.height;
+	if (fmt.width != AR_FRAME_REF_W || fmt.height != AR_FRAME_REF_H)
+		dev_info(isp->dev, "frame %ux%u: the 1080p replay's geometry rewritten\n",
+			 fmt.width, fmt.height);
 	ar_isp_configure_prefix(isp, setup_entries);
 	ar_isp_arm_output(isp);
 	if (fmt.code == MEDIA_BUS_FMT_SBGGR10_1X10) {
diff --git a/overlay/drivers/media/artosyn/ar-isp-priv.h b/overlay/drivers/media/artosyn/ar-isp-priv.h
index 242ce2b..7e9dfb1 100644
--- a/overlay/drivers/media/artosyn/ar-isp-priv.h
+++ b/overlay/drivers/media/artosyn/ar-isp-priv.h
@@ -14,6 +14,7 @@
 #ifndef AR_ISP_PRIV_H
 #define AR_ISP_PRIV_H
 
+#include "ar-frame-geom.h"
 #include <linux/clk.h>
 #include <linux/debugfs.h>
 #include <linux/io.h>
@@ -159,8 +160,45 @@ struct ar_isp {
 	 */
 	void *de3d[3];
 	dma_addr_t de3d_dma[3];
+
+	/* The frame the sensor sends, from the VIF at pipeline start. */
+	u32 frame_w, frame_h;
+};
+
+/*
+ * The replayed registers that hold the frame: every one the provenance audit
+ * classes as frame geometry, and the statistics windows whose library image
+ * is the 1080p frame. ar-frame-geom.h rewrites them for another frame size.
+ * Not 0x0024 (a compander length that equals 1920) nor the cfa word 0x082c,
+ * which ar_isp_pipeline_start writes from the frame itself. Nor LTM's 0x2804:
+ * its tile registers keep the 1080p grid (8 rows of 135), and with only the
+ * frame shortened LTM darkened the whole picture and stepped down another 18%
+ * at row 675, the sixth tile row (P1, 720p90, 2026-11-17). With its 1080p
+ * frame the 720 rows are its first 720, as in 1080p; its page is an identity
+ * curve, so nothing else in it depends on the height.
+ */
+static const u16 ar_isp_frame_regs[] = {
+	0x0c04, 0x0c08, 0x1804, 0x1c00, 0x1c04, 0x1d54, 0x1d5c, 0x1dac,
+	0x1db4, 0x1dfc, 0x1e00, 0x1e0c, 0x1e10, 0x1e64, 0x1e68, 0x1f74,
+	0x1f7c, 0x2e04, 0x2e08, 0x2e0c, 0x2e50, 0x4c04, 0x4c0c,
+	0x4c14, 0x4c1c, 0x6024, 0x6028, 0x602c, 0x6030, 0x6040, 0x6044,
+	0x642c, 0x6434, 0x6460, 0x6468, 0x64f4, 0x64fc, 0x6c40, 0x6c44,
+	0x6c68, 0x6c6c, 0x6ce8, 0x6cec, 0x6d10, 0x6d14, 0x706c, 0x7070,
+	0x7074, 0x7078, 0x707c, 0x7080, 0x7204, 0x7208, 0x7240, 0x7244,
+	0x7274,
 };
 
+static inline u32 ar_isp_frame_remap(const struct ar_isp *isp, u16 off, u32 val)
+{
+	if (!isp->frame_w || (isp->frame_w == AR_FRAME_REF_W &&
+			      isp->frame_h == AR_FRAME_REF_H))
+		return val;
+	for (unsigned int i = 0; i < ARRAY_SIZE(ar_isp_frame_regs); i++)
+		if (ar_isp_frame_regs[i] == off)
+			return ar_frame_geom_remap(val, isp->frame_w, isp->frame_h);
+	return val;
+}
+
 /* Translate every replayed DMA descriptor before it reaches hardware.
  * The reference application's addresses are not owned by this driver, even
  * briefly during initialization. Tables are filled before the replay starts.
@@ -187,6 +225,7 @@ static inline void ar_isp_replay_write(struct ar_isp *isp, u16 off, u32 val)
 	case 0x6440: case 0x6474:
 		val = lower_32_bits(isp->rro_dma); break;
 	case 0x6508: val = lower_32_bits(isp->rro_face_dma); break;
+	default: val = ar_isp_frame_remap(isp, off, val); break;
 	}
 	writel(val, isp->base + off);
 }
