config BR2_PACKAGE_KESTREL_NATIVE
	bool "Kestrel native AR9311 boot runtime"
	depends on BR2_FPVOS_BOARD_ASCENT_VRX || BR2_FPVOS_BOARD_P1_GOGGLE || BR2_FPVOS_BOARD_SKYZONE_STEADYDIGITAL
	help
	  Install a static, read-only Kestrel runtime and boot
	  supervisor.
	  First create the SquashFS image with kestrel-gnd's
	  tools/package_ascent.py, then supply its absolute path as
	  KESTREL_NATIVE_IMAGE when invoking make. The firmware
	  package includes the runtime; no host or SD application
	  install is needed.
	  Set KESTREL_NATIVE_SHA256 to the image's sha256 to pin
	  it (a different file fails the build). The image's sha256
	  is always installed as /usr/share/kestrel/runtime.sha256.
