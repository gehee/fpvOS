config BR2_PACKAGE_KESTREL_NATIVE
	bool "Kestrel native AR9311 boot runtime"
	depends on BR2_FPVOS_BOARD_ASCENT_VRX || BR2_FPVOS_BOARD_P1_GOGGLE || BR2_FPVOS_BOARD_SKYZONE_STEADYDIGITAL
	help
	  Install a static, read-only Kestrel runtime and boot
	  supervisor.
	  The runtime is built from fpvOS's kestrel-gnd and
	  ar_libre pins by scripts/native-runtime.sh (build.sh runs
	  it), and pinned in runtime.hash: another file fails the
	  build. KESTREL_NATIVE_IMAGE with KESTREL_NATIVE_SHA256=
	  takes a runtime of your own. The firmware package includes
	  the runtime; no host or SD application install is needed.
	  The image's sha256 is always installed as
	  /usr/share/kestrel/runtime.sha256.
