#!/bin/sh
# All application bits are firmware-owned. Only data lives on removable storage.
set -eu
umask 077
[ ! -r /etc/default/kestrel-native ] || . /etc/default/kestrel-native
state=/var/lib/kestrel
# On the Ascent VRX this is a link to the card (S46kestrel-state); a card gone
# since boot leaves it dangling, and the receiver must still start. A link's
# target is never created here, so nothing lands in the RAM root's /mnt/sd.
if ! { mkdir -p "$state" && [ -d "$state" ] && [ -w "$state" ]; } 2>/dev/null; then
    echo "Kestrel: $state unavailable; settings and pairing are temporary" >&2
    state=/run/kestrel-state
    mkdir -p "$state"
fi
set --
if [ "${KESTREL_NATIVE_NO_RADIO:-0}" = 1 ]; then
    set -- "$@" --no-radio
fi
if [ -n "${KESTREL_NATIVE_BACKLIGHT:-}" ]; then
    # A missing node costs the backlight setting, not the receiver.
    { echo "${KESTREL_NATIVE_BRIGHTNESS:-5}" > "$KESTREL_NATIVE_BACKLIGHT"; } 2>/dev/null ||
        echo "Kestrel: cannot set $KESTREL_NATIVE_BACKLIGHT" >&2
    # Brightness alone does not unblank a backlight that probed powered off.
    { echo 0 > "${KESTREL_NATIVE_BACKLIGHT%/*}/bl_power"; } 2>/dev/null ||
        echo "Kestrel: cannot unblank ${KESTREL_NATIVE_BACKLIGHT%/*}" >&2
fi
recordings=/run/kestrel-gnd/no-sd/recordings
# Recording storage is independent of whether settings have been migrated.
# Never fall back to recording into the RAM rootfs when the card is absent.
# Links are fine while they resolve to a directory on the card itself; one
# pointing off the card, or dangling, is refused before mkdir follows it.
on_card() {
    if [ ! -e "$1" ] && [ ! -L "$1" ]; then return 0; fi
    case "$(readlink -f "$1")" in /mnt/sd/?*) return 0 ;; esac
    return 1
}
if awk '$2 == "/mnt/sd" && $4 ~ /(^|,)rw(,|$)/ { found=1 } END { exit !found }' /proc/mounts; then
    if on_card /mnt/sd/fpvos && on_card /mnt/sd/fpvos/recordings &&
       mkdir -p /mnt/sd/fpvos/recordings && on_card /mnt/sd/fpvos/recordings; then
        recordings=/mnt/sd/fpvos/recordings
    else
        echo 'Kestrel: recording directory unavailable; continuing without recording' >&2
    fi
fi
exec /opt/kestrel/bin/kestrel-gnd --assets /opt/kestrel/ui \
    --control /run/kestrel-gnd/control --preferences "$state/ui.conf" \
    --settings "$state/receiver.conf" --pairing "$state/peer" \
    --recordings "$recordings" "$@"
