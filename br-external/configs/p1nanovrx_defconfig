# BETAFPV P1 Nano VRX: fpvOS in NAND bank 0 with independent recovery; stock bank 1 preserved.
BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_6_18=y
BR2_STATIC_LIBS=y
BR2_TARGET_GENERIC_HOSTNAME="fpvos-p1-nano-vrx"
BR2_TARGET_GENERIC_ISSUE="fpvOS P1 Nano VRX (experimental)"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/rootfs-overlay $(BR2_EXTERNAL_FPVOS_PATH)/board/p1-nano-vrx/rootfs-overlay"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.36.tar.xz"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/linux-patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/linux.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/linux.fragment $(BR2_EXTERNAL_FPVOS_PATH)/board/p1-nano-vrx/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/dts $(BR2_EXTERNAL_FPVOS_PATH)/board/p1-nano-vrx/dts"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/busybox.fragment $(BR2_EXTERNAL_FPVOS_PATH)/board/p1-nano-vrx/busybox.fragment"
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_MEMTESTER=y
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_CPIO_UIMAGE=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_FPVOS_BOARD_P1_NANO_VRX=y
BR2_PACKAGE_AR9311_MMC=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
BR2_PACKAGE_AR9311_MEDIA_TEST=y
BR2_PACKAGE_KESTREL_NATIVE=y

BR2_PACKAGE_MTD=y
BR2_PACKAGE_AR9311_RADIO=y
BR2_PACKAGE_AR9311_RADIO_CALIBRATION=y
BR2_PACKAGE_OPEN8030_PROFILE="betafpv-p1-nano-vrx.c"
BR2_PACKAGE_OPEN8030_TRANSPORT_SDIO=y
BR2_PACKAGE_OPEN8030_PINS_BEFORE_FACTORY=y
BR2_PACKAGE_OPEN8030_EXPLICIT_IO_DOMAINS=y
BR2_PACKAGE_OPEN8030_FACTORY_OPTIONAL=y
BR2_PACKAGE_OPEN8030_CONFIG="$(BR2_EXTERNAL_FPVOS_PATH)/board/p1-nano-vrx/radio.json"

BR2_PACKAGE_AR9311_FIRMWARE=y
BR2_PACKAGE_AR9311_FIRMWARE_P1_GOGGLE_1_0_36=y

BR2_PACKAGE_FPVOS_UPDATE=y
BR2_PACKAGE_FPVOS_UPDATE_P1_NANO_VRX=y
BR2_PACKAGE_FPVOS_RECOVERY=y
BR2_PACKAGE_HOST_LZ4=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FPVOS_PATH)/board/p1-nano-vrx/post-image.sh"
