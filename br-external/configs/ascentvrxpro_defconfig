BR2_aarch64=y
BR2_cortex_a55=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# The toolchain's headers stay Buildroot's latest, as before the kernel was
# built here. Left to default, building a kernel switches them to "same as
# the kernel", guesses a custom tree is 2.x, and glibc - which needs 3.2 or
# later - silently gives way to uClibc.
BR2_KERNEL_HEADERS_6_18=y
BR2_TARGET_GENERIC_HOSTNAME="vrxpro"
BR2_TARGET_GENERIC_ISSUE="fpvOS VRX Pro (RK3568)"
BR2_TARGET_GENERIC_ROOT_PASSWD="fpvos"
BR2_TARGET_GENERIC_GETTY_PORT="ttyFIQ0"
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
# partx: S35dvrpart hands the new recordings partition to the running kernel,
# so the first boot formats and mounts it instead of waiting for a second one.
BR2_PACKAGE_UTIL_LINUX_PARTX=y
# S35dvrpart formats the p4 recordings partition as exFAT; without this the
# mkfs.exfat call it depends on doesn't exist, the format silently fails, and
# every recording falls through to the tiny rootfs instead.
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_HTOP=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# 560M was for LLVM and Clang in the target, which post-build.sh now removes;
# the rootfs holds about 90 MB. The p2 partition is 619 MB.
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_TARGET_ROOTFS_TAR=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_JQ=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_FFMPEG_AVFORMAT=y
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_CAIRO_PNG=y
# GL/EGL/GBM come from Mesa's Panfrost driver, fully open: kestrel renders the
# HUD on the Mali-G52 through it. Buildroot builds Panfrost only with LLVM,
# for the shader tools Mesa runs at build time. None of it is needed on the
# goggle: external.mk builds Mesa itself without LLVM, and post-build.sh
# removes the LLVM, Clang and SPIR-V files Buildroot installs anyway.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# Wayland: from when the stock libmali (the wayland-gbm variant) was the GL
# stack. fpvOS runs no Wayland compositor; Mesa just builds its Wayland EGL
# platform alongside GBM.
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_PIXMAN=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx-pro/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx-pro/post-build.sh"
BR2_PACKAGE_ROCKCHIP_MPP=y
BR2_PACKAGE_FPVOS_VENDOR_LIBS=y
BR2_PACKAGE_KESTREL=y
# mtd-utils: only what S50factory needs to read stock's pairing list off the
# NAND. Everything that can erase or write flash stays out of the image.
BR2_PACKAGE_MTD=y
BR2_PACKAGE_MTD_MTDPART=y
BR2_PACKAGE_MTD_UBIATTACH=y
BR2_PACKAGE_MTD_UBIDETACH=y
# BR2_PACKAGE_MTD_FLASHCP is not set
# BR2_PACKAGE_MTD_FLASH_ERASE is not set
# BR2_PACKAGE_MTD_FLASH_LOCK is not set
# BR2_PACKAGE_MTD_FLASH_UNLOCK is not set
# BR2_PACKAGE_MTD_MTD_DEBUG is not set
# BR2_PACKAGE_MTD_NANDDUMP is not set
# BR2_PACKAGE_MTD_NANDTEST is not set
# BR2_PACKAGE_MTD_NANDWRITE is not set
# BR2_PACKAGE_MTD_MTDINFO is not set
# BR2_PACKAGE_MTD_UBICRC32 is not set
# BR2_PACKAGE_MTD_UBIFORMAT is not set
# BR2_PACKAGE_MTD_UBIHEALTHD is not set
# BR2_PACKAGE_MTD_UBIMKVOL is not set
# BR2_PACKAGE_MTD_UBINFO is not set
# BR2_PACKAGE_MTD_UBINIZE is not set
# BR2_PACKAGE_MTD_UBIRENAME is not set
# BR2_PACKAGE_MTD_UBIRMVOL is not set
# BR2_PACKAGE_MTD_UBIRSVOL is not set
# BR2_PACKAGE_MTD_UBIUPDATEVOL is not set
# BR2_PACKAGE_MTD_UBIBLOCK is not set
# btop, and the UTF-8 locale it needs to draw
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_PACKAGE_BTOP=y
# WiFi access point (usr/sbin/fpvos-wifi, toggled from kestrel's SYSTEM tab):
# hostapd for the AP, iw for the scan that picks the channel, and busybox's
# udhcpd for addresses.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx-pro/busybox.fragment"
BR2_PACKAGE_HOSTAPD=y
# BR2_PACKAGE_HOSTAPD_DRIVER_HOSTAP is not set
# BR2_PACKAGE_HOSTAPD_ACS is not set
# BR2_PACKAGE_HOSTAPD_VLAN is not set
BR2_PACKAGE_IW=y
# The SD boot chain, made from the stock boot images (boot/mkbootchain.py).
BR2_PACKAGE_FPVOS_BOOTCHAIN=y
# The kernel, built from source: Rockchip's develop-6.12 tree, with the stock
# 5.10 config carried forward plus board/ascent-vrx-pro/linux.fragment. The boot chain
# puts it in the SD FIT in place of the stock kernel; the device tree stays
# the stock one, with fpvOS's edits. See docs/KERNEL.md.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,rockchip-linux,kernel,470f9dccbdc42e7b8a824d0a5c5640a10e9457d2)/kernel-470f9dccbdc42e7b8a824d0a5c5640a10e9457d2.tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx-pro/linux-5.10.198-stock.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx-pro/linux.fragment"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx-pro/linux-patches"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# The AR8030 radio stack: arlink.ko, built from source against that kernel, and
# the client library. Artosyn's driver, daemon and library are not shipped.
BR2_PACKAGE_AR_LIBRE=y
# Open8030, the open radio firmware, next to stock's (RADIO > Radio Firmware
# picks it); built with the published VRX Pro profile.
BR2_PACKAGE_OPEN8030=y
BR2_PACKAGE_OPEN8030_PROFILE="ascent-vrx-pro.c"
BR2_PACKAGE_OPEN8030_TRANSPORT_USB=y
# Firmware for the onboard WiFi (rtlwifi/rtl8188fufw.bin), which the kernel's
# rtl8xxxu driver loads.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_FPVOS_UPDATE=y
BR2_PACKAGE_FPVOS_UPDATE_ASCENT_VRX_PRO=y
BR2_PACKAGE_FPVOS_USB=y
