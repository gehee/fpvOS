# Skyzone SteadyDigital receiver (Artosyn Proxima AR9311, Cortex-A53).
# Linux 6.18 RAM image: codec, DSI to the LT9611 HDMI bridge, SDIO radio, USB.
BR2_aarch64=y
BR2_cortex_a53=y
BR2_FPVOS_BOARD_SKYZONE_STEADYDIGITAL=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_STATIC_LIBS=y
BR2_KERNEL_HEADERS_6_18=y
BR2_TARGET_GENERIC_HOSTNAME="fpvos-steadydigital"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_TARGET_GENERIC_ISSUE="fpvOS SteadyDigital (experimental)"
BR2_INIT_BUSYBOX=y
# The board's inittab opens a local shell on ttyS0 at the kernel's baud.
# BR2_TARGET_GENERIC_GETTY is not set
# Receiver services shared with the Ascent VRX, then this board's identity.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/rootfs-overlay $(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx/rootfs-overlay $(BR2_EXTERNAL_FPVOS_PATH)/board/skyzone-steadydigital/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FPVOS_PATH)/board/skyzone-steadydigital/post-image.sh"
BR2_PACKAGE_HOST_LZ4=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/busybox.fragment"
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_KESTREL_NATIVE=y
BR2_PACKAGE_AR9311_MMC=y
BR2_PACKAGE_AR9311_MEDIA_TEST=y
BR2_PACKAGE_AR9311_TEMP=y
BR2_PACKAGE_AR9311_FIRMWARE=y
BR2_PACKAGE_AR9311_FIRMWARE_ASCENT_17_5_15=y
BR2_PACKAGE_AR9311_RADIO=y
BR2_PACKAGE_OPEN8030_PROFILE="skyzone-steadydigital.c"
BR2_PACKAGE_OPEN8030_TRANSPORT_SDIO=y
# The board's AR8030 has no factory SPI flash.
BR2_PACKAGE_OPEN8030_FACTORY_OPTIONAL=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_MEMTESTER=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_CPIO_UIMAGE=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.36.tar.xz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/linux.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/linux.fragment $(BR2_EXTERNAL_FPVOS_PATH)/board/skyzone-steadydigital/linux.fragment"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/linux-patches"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/dts $(BR2_EXTERNAL_FPVOS_PATH)/board/skyzone-steadydigital/dts"
