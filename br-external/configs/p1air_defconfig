# P1 stock-runtime bring-up. Buildroot's rootfs/kernel are not flashed.
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_6_18=y
BR2_TARGET_GENERIC_HOSTNAME="p1-air"
BR2_TARGET_GENERIC_ISSUE="fpvOS P1 Air stock-runtime development"
BR2_FPVOS_SOC_AR9311=y
BR2_PACKAGE_P1_AIR_VENDOR=y
BR2_PACKAGE_OPEN8030=y
BR2_PACKAGE_OPEN8030_PROFILE_P1_STOCK=y
BR2_PACKAGE_OPEN8030_TRANSPORT_SDIO=y
BR2_PACKAGE_OPEN8030_ROLE_AP=y
BR2_PACKAGE_OPEN8030_FACTORY_OPTIONAL=y
BR2_PACKAGE_OPEN8030_PINS_BEFORE_FACTORY=y
BR2_PACKAGE_OPEN8030_EXPLICIT_IO_DOMAINS=y
BR2_PACKAGE_OPEN8030_SDIO_BLOCK_TRAILER=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FPVOS_PATH)/board/p1-air/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FPVOS_PATH)/board/p1-air/post-image.sh"
# BR2_TARGET_ROOTFS_TAR is not set
