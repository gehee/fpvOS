# Ascent VRX receiver (Gnd485; Artosyn Proxima AR9311, Cortex-A53).
# Linux 6.18 platform: codec, DRM/HDMI, SDIO radio and NAND recovery/update.
BR2_aarch64=y
BR2_cortex_a53=y
BR2_FPVOS_BOARD_ASCENT_VRX=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_STATIC_LIBS=y
BR2_KERNEL_HEADERS_6_18=y
BR2_TARGET_GENERIC_HOSTNAME="fpvos-ar9311"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_TARGET_GENERIC_ISSUE="fpvOS Ascent VRX"
BR2_INIT_BUSYBOX=y
# The board's inittab opens a local shell on ttyS0, preserving the baud rate
# set by the kernel (console=ttyS0,1152000).
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/rootfs-overlay $(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx/post-image.sh"
BR2_PACKAGE_HOST_LZ4=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/busybox.fragment"
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_AR9311_MMC=y
BR2_PACKAGE_AR9311_MEDIA_TEST=y
BR2_PACKAGE_KESTREL_NATIVE=y
BR2_PACKAGE_AR9311_FIRMWARE=y
BR2_PACKAGE_AR9311_FIRMWARE_ASCENT_17_5_15=y
BR2_PACKAGE_AR9311_RADIO=y
BR2_PACKAGE_OPEN8030_PROFILE="$(BR2_EXTERNAL_FPVOS_PATH)/../vendor/open8030/ascent-vrx.c"
BR2_PACKAGE_OPEN8030_TRANSPORT_SDIO=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_MEMTESTER=y
BR2_PACKAGE_FPVOS_UPDATE=y
BR2_PACKAGE_FPVOS_UPDATE_ASCENT_VRX=y
BR2_PACKAGE_FPVOS_RECOVERY=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_CPIO_UIMAGE=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.36.tar.xz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/linux.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/linux.fragment $(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx/linux.fragment"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/linux-patches $(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx/linux-patches"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_FPVOS_PATH)/board/common/ar9311/dts $(BR2_EXTERNAL_FPVOS_PATH)/board/ascent-vrx/dts"
